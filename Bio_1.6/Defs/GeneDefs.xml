<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GeneDef>
        <defName>Mugirl_Charge</defName>
        <!-- 雪牛冲锋！ -->
        <label>Mugirl Charge!</label>
        <!-- 这种基因的携带者具有强大爆发能力，可以再短时间加速冲向敌人，据说这是一种拥抱战斗的荣耀传统形式。 -->
        <description>Carriers of this gene possess explosive power, allowing them to accelerate toward enemies in a short time. It is said to be a traditional way to embrace the glory of battle.</description>
        <iconPath>UI/Mugirl_Charge</iconPath>
        <displayCategory>Ability</displayCategory>
        <displayOrderInCategory>1</displayOrderInCategory>
        <abilities>
            <li>Mugirl_Charge</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef>Mugirl_Charge</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-2</biostatMet>
        <biostatCpx>6</biostatCpx>
    </GeneDef>

    <GeneDef>
        <defName>Mugirl_Throw</defName>
        <label>Mugirl throw</label>
        <description>Carriers of this gene can lift nearby objects and hurl them as devastating improvised projectiles.</description>
        <iconPath>UI/Mugirl_Charge</iconPath>
        <displayCategory>Ability</displayCategory>
        <displayOrderInCategory>3</displayOrderInCategory>
        <abilities>
            <li>Mugirl_Throw</li>
            <li>Mugirl_Dunk</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef>Mugirl_Throw</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-3</biostatMet>
        <biostatCpx>6</biostatCpx>
    </GeneDef>

    <GeneDef>
        <defName>Mugirl_Shout</defName>
        <!-- 雪牛大叫！ -->
        <label>Mugirl Shout!</label>
        <!-- 这种基因的携带者拥有独特的吼声，这种奇怪的叫声会令周围的敌人忍不住殴打他，具有嘲讽能力。（RUA~！） -->
        <description>Carriers of this gene have a unique roar. This strange cry provokes nearby enemies into attacking them, functioning as a taunt. (RUA~!)</description>
        <iconPath>UI/Mugirl_Shout</iconPath>
        <displayCategory>Ability</displayCategory>
        <displayOrderInCategory>2</displayOrderInCategory>
        <abilities>
            <li>Mugirl_Shout</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef>Mugirl_Shout</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-2</biostatMet>
        <biostatCpx>4</biostatCpx>
    </GeneDef>

    <GeneDef>
        <defName>Mugirl_Shooting</defName>
        <!-- 雪牛砰砰砰！ -->
        <label>Mugirl Bang-Bang-Bang!</label>
        <!-- 这种基因的携带者耐不住性子，喜欢乱开枪，厌恶瞄准。 -->
        <description>Carriers of this gene are impatient, like firing wildly, and dislike careful aiming.</description>
        <iconPath>UI/Mugirl_Shooting</iconPath>
        <displayCategory>Violence</displayCategory>
        <displayOrderInCategory>1</displayOrderInCategory>
        <biostatMet>-2</biostatMet>
        <forcedTraits>
            <li>
                <def>ShootingAccuracy</def>
                <degree>-1</degree>
            </li>
        </forcedTraits>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>chaos</symbol>
                </li>
                <li>
                    <symbol>mad</symbol>
                </li>
                <li>
                    <symbol>wild</symbol>
                </li>
                <li>
                    <symbol>noise</symbol>
                </li>
            </prefixSymbols>
            <suffixSymbols>
                <li>
                    <symbol>gunfire</symbol>
                </li>
                <li>
                    <symbol>spray</symbol>
                </li>
                <li>
                    <symbol>barrage</symbol>
                </li>
                <li>
                    <symbol>burst</symbol>
                </li>
            </suffixSymbols>
        </symbolPack>
    </GeneDef>

    <GeneDef>
        <defName>Mugirl_NobelPrize</defName>
        <!-- 雪牛大葱鸣！ -->
        <label>Mugirl Nobel Memory!</label>
        <!-- 这种基因的携带者学习能力低下，但是好在记忆力强。雪牛也有机会获得诺背耳奖！ -->
        <description>Carriers of this gene learn slowly, but fortunately have strong memory. Even a Mugirl might win a Nobel-ish prize!</description>
        <iconPath>UI/Mugirl_NobelPrize</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>1</displayOrderInCategory>
        <biostatMet>-1</biostatMet>
        <statFactors>
            <GlobalLearningFactor>0.85</GlobalLearningFactor>
            <ResearchSpeed>0.6</ResearchSpeed>
        </statFactors>
        <forcedTraits>
            <li>
                <def>GreatMemory</def>
            </li>
        </forcedTraits>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>fixed</symbol>
                </li>
                <li>
                    <symbol>etched</symbol>
                </li>
                <li>
                    <symbol>locked</symbol>
                </li>
                <li>
                    <symbol>stubborn</symbol>
                </li>
            </prefixSymbols>
            <suffixSymbols>
                <li>
                    <symbol>memory</symbol>
                </li>
                <li>
                    <symbol>brain</symbol>
                </li>
                <li>
                    <symbol>archive</symbol>
                </li>
                <li>
                    <symbol>engrams</symbol>
                </li>
            </suffixSymbols>
        </symbolPack>
    </GeneDef>

</Defs>
