<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GeneDef>
        <defName>MooGirl_Charge</defName>
        <label>雪牛冲锋！</label>
        <description>这种基因的携带者具有强大爆发能力，可以再短时间加速冲向敌人，据说这是一种拥抱战斗的荣耀传统形式。</description>
        <iconPath>UI/MooGirl_Charge</iconPath>
        <displayCategory>Ability</displayCategory>
        <displayOrderInCategory>1</displayOrderInCategory>
        <abilities>
            <li>MooGirl_Charge</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef>MooGirl_Charge</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-2</biostatMet>
        <biostatCpx>6</biostatCpx>
    </GeneDef>

    <GeneDef>
        <defName>MooGirl_Shout</defName>
        <label>雪牛大叫！</label>
        <description>这种基因的携带者拥有独特的吼声，这种奇怪的叫声会令周围的敌人忍不住殴打他，具有嘲讽能力。（RUA~！）</description>
        <iconPath>UI/MooGirl_Shout</iconPath>
        <displayCategory>Ability</displayCategory>
        <displayOrderInCategory>2</displayOrderInCategory>
        <abilities>
            <li>MooGirl_Shout</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef>MooGirl_Shout</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-2</biostatMet>
        <biostatCpx>4</biostatCpx>
    </GeneDef>

    <GeneDef>
        <defName>MooGirl_Shooting</defName>
        <label>雪牛砰砰砰！</label>
        <description>这种基因的携带者耐不住性子，喜欢乱开枪，厌恶瞄准。</description>
        <iconPath>UI/MooGirl_Shooting</iconPath>
        <displayCategory>Violence</displayCategory>
        <displayOrderInCategory>1</displayOrderInCategory>
        <biostatMet>-2</biostatMet>
        <forcedTraits>
            <li>
                <def>ShootingAccuracy</def>
                <degree>-1</degree>
            </li>
        </forcedTraits>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>chaos</symbol>
                </li>
                <li>
                    <symbol>mad</symbol>
                </li>
                <li>
                    <symbol>wild</symbol>
                </li>
                <li>
                    <symbol>noise</symbol>
                </li>
            </prefixSymbols>
            <suffixSymbols>
                <li>
                    <symbol>gunfire</symbol>
                </li>
                <li>
                    <symbol>spray</symbol>
                </li>
                <li>
                    <symbol>barrage</symbol>
                </li>
                <li>
                    <symbol>burst</symbol>
                </li>
            </suffixSymbols>
        </symbolPack>
    </GeneDef>

    <GeneDef>
        <defName>MooGirl_NobelPrize</defName>
        <label>雪牛大葱鸣！</label>
        <description>这种基因的携带者学习能力低下，但是好在记忆力强。雪牛也有机会获得诺背耳奖！</description>
        <iconPath>UI/MooGirl_NobelPrize</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>1</displayOrderInCategory>
        <biostatMet>-1</biostatMet>
        <statFactors>
            <GlobalLearningFactor>0.85</GlobalLearningFactor>
            <ResearchSpeed>0.6</ResearchSpeed>
        </statFactors>
        <forcedTraits>
            <li>
                <def>GreatMemory</def>
            </li>
        </forcedTraits>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>fixed</symbol>
                </li>
                <li>
                    <symbol>etched</symbol>
                </li>
                <li>
                    <symbol>locked</symbol>
                </li>
                <li>
                    <symbol>stubborn</symbol>
                </li>
            </prefixSymbols>
            <suffixSymbols>
                <li>
                    <symbol>memory</symbol>
                </li>
                <li>
                    <symbol>brain</symbol>
                </li>
                <li>
                    <symbol>archive</symbol>
                </li>
                <li>
                    <symbol>engrams</symbol>
                </li>
            </suffixSymbols>
        </symbolPack>
    </GeneDef>

</Defs>