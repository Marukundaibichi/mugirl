<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- PatchGovernance:
    Targets: MooGirl AlienRace ThingDef comps when Facial Animation is active.
    Scope: optional FacialAnimation load folder; appends only FacialAnimation comp classes to the MooGirl race def.
    Duplicate guard: each comp add checks for its compClass before insertion and creates the comps list only when absent.
    Failure: missing MooGirl race target is acceptable during partial load and produces no patch action.
    -->
    <!-- Facial Animation folder only loads when the mod is active; still gate on the MooGirl race Def. 即使目录已按 FA 启用，也只在雪牛娘种族 Def 存在时补丁。 -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]</xpath>
                        <value>
                            <comps/>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.DrawFaceGraphicsComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.DrawFaceGraphicsComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.HeadControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.HeadControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.EyeballControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.EyeballControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.LidControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.LidControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.BrowControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.BrowControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.MouthControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.MouthControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.LidOptionControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.LidOptionControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.EmotionControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.EmotionControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>

                <li Class="PatchOperationConditional">
                    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps/li/compClass[text()="FacialAnimation.FacialAnimationControllerComp"]</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="MooGirl"]/comps</xpath>
                        <value>
                            <li><compClass>FacialAnimation.FacialAnimationControllerComp</compClass></li>
                        </value>
                    </nomatch>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
