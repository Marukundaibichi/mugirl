<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
      三个角色共用程序化 Worker。Self/Target 使用原有的头部旋转中心；
      Helper 保持默认中心，避免辅助者的前倾动作发生视觉漂移。
    -->
    <AnimationDef>
        <defName>Mugirl_MilkingSelfAnimation</defName>
        <durationTicks>1</durationTicks>
        <loopMode>Loop</loopMode>
        <keyframeParts>
            <li>
                <key>Root</key>
                <value>
                    <workerType>Mugirl.MugirlMilkingAnimationWorker</workerType>
                </value>
            </li>
            <li>
                <key>Head</key>
                <value>
                    <workerType>Mugirl.MugirlMilkingAnimationWorker</workerType>
                    <pivot>(0.5, 0.42)</pivot>
                </value>
            </li>
        </keyframeParts>
    </AnimationDef>

    <AnimationDef>
        <defName>Mugirl_MilkingTargetAnimation</defName>
        <durationTicks>1</durationTicks>
        <loopMode>Loop</loopMode>
        <keyframeParts>
            <li>
                <key>Root</key>
                <value>
                    <workerType>Mugirl.MugirlMilkingAnimationWorker</workerType>
                </value>
            </li>
            <li>
                <key>Head</key>
                <value>
                    <workerType>Mugirl.MugirlMilkingAnimationWorker</workerType>
                    <pivot>(0.5, 0.42)</pivot>
                </value>
            </li>
        </keyframeParts>
    </AnimationDef>

    <AnimationDef>
        <defName>Mugirl_MilkingHelperAnimation</defName>
        <durationTicks>1</durationTicks>
        <loopMode>Loop</loopMode>
        <keyframeParts>
            <li>
                <key>Root</key>
                <value>
                    <workerType>Mugirl.MugirlMilkingAnimationWorker</workerType>
                </value>
            </li>
            <li>
                <key>Head</key>
                <value>
                    <workerType>Mugirl.MugirlMilkingAnimationWorker</workerType>
                </value>
            </li>
        </keyframeParts>
    </AnimationDef>
</Defs>
