<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <PawnKindDef Name="Mugirl_SlaveBase" ParentName="Mugirl_BaseKind" Abstract="True">
        <combatPower>30</combatPower>
        <race>Mugirl</race>
        <itemQuality>Poor</itemQuality>
        <chemicalAddictionChance>0.06</chemicalAddictionChance>
        <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
        <backstoryFiltersOverride>
            <li>
                <categories>
                    <li>Mugirl_Slave</li>
                </categories>
            </li>
        </backstoryFiltersOverride>
        <isFighter>true</isFighter> <!-- 是否具有战斗能力 -->
        <chemicalAddictionChance>0.01</chemicalAddictionChance> <!-- 生成时有概率有化学成瘾 -->
        <gearHealthRange>0.8~1</gearHealthRange> <!-- 装备耐久度 -->
        <apparelMoney>0~1000000</apparelMoney>
        <apparelAllowHeadgearChance>0.75</apparelAllowHeadgearChance> <!-- 不允许生成头部装备 -->
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons> <!-- 生成服装不受季节影响 -->
        <apparelIgnorePollution MayRequire="Ludeon.RimWorld.Biotech">true</apparelIgnorePollution>
        <invNutrition>1</invNutrition> <!-- 初始携带食物总营养值 -->
        <invFoodDef>Hay</invFoodDef> <!-- 初始携带的食物类型 干草 -->
        <initialWillRange>0~1</initialWillRange> <!-- 奴隶意志值 -->
        <initialResistanceRange>10~17</initialResistanceRange> <!-- 招募时的抗拒值范围 -->
    </PawnKindDef>

    <PawnKindDef ParentName="Mugirl_SlaveBase">
        <defName>Mugirl_Beginning_Slave</defName>
        <!-- 雪牛迫降奴隶 -->
        <label>Crashlanded Mugirl Slave</label>
