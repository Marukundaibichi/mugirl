            <li>Mugirl_Slave_Shell_Upper</li>
            <li>Mugirl_Slave_Shell_Lower</li>
            <li>Mugirl_Slave_Gags</li>
            <li>Mugirl_Slave_Earplugs</li>
            <li>Mugirl_Slave_Blinder</li>
        </apparelTags>
        <initialWillRange>0~1</initialWillRange>
        <initialResistanceRange>10~17</initialResistanceRange>
    </PawnKindDef>

