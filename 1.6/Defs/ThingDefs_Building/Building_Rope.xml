<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="NonBuildableLampBase">
        <defName>WallRopeHitch</defName>
        <!-- 墙壁栓点 -->
        <label>Wall Rope Hitch</label>
        <!-- 墙上的铁环，可用来将雪牛娘安全固定。她们在被牵引时会表现出一种本能的顺从，这是长期改造与驯化的结果。 -->
        <description>Wall-mounted iron rings can be used to safely secure Mugirls. They display an instinctive compliance when being led, a result of prolonged modification and domestication.</description>
        <designationCategory>Furniture</designationCategory>
        <minifiedDef>MinifiedThing</minifiedDef>
        <uiOrder>2800</uiOrder>
        <thingCategories>
            <li>BuildingsFurniture</li>
        </thingCategories>
        <rotatable>true</rotatable>
        <graphicData>
            <texPath>Things/Building/WallRopeHitch/WallRopeHitch</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
            <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
            <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
            <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
            <damageData>
                <enabled>false</enabled>
            </damageData>
        </graphicData>
        <uiIconPath>Things/Building/WallRopeHitch/WallRopeHitch</uiIconPath>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <costList>
            <Steel>15</Steel>
        </costList>
        <statBases>
            <WorkToBuild>330</WorkToBuild>
            <MaxHitPoints>35</MaxHitPoints>
            <Mass>2</Mass>
        </statBases>
        <uiOrder>2991</uiOrder>
        <passability>Standable</passability>
        <terrainAffordanceNeeded IsNull="True" />
        <pathCost>0</pathCost>
        <overrideMinifiedRot>North</overrideMinifiedRot>
        <minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset>
        <building>
            <isEdifice>false</isEdifice>
            <isAttachment>true</isAttachment>
        </building>
        <placeWorkers>
            <li>Placeworker_AttachedToWall</li>
        </placeWorkers>
        <researchPrerequisites>
            <li>ComplexFurniture</li>
        </researchPrerequisites>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <comps>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Usable">
                <compClass>MooGirl.CompRopeToBuild</compClass>
                <useJob>RopeToBuild</useJob>
                <!-- 栓在建筑上 -->
                <useLabel>Rope to Building</useLabel>
            </li>
        </comps>
    </ThingDef>

</Defs>