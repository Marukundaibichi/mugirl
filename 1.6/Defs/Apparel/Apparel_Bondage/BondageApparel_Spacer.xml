    <Mugirl.SlaveApparelDef ParentName="Mugirl_SlaveApparel_Spacer">
        <defName>Mugirl_ShockCollar</defName>
        <!-- 雪牛娘 电击项圈 -->
        <label>Mugirl Electric Shock Collar</label>
        <!-- 由太空巨企专门设计的控制型束具，外观为紧贴在颈部的金属项圈。其内部电极会不定期释放电流，对佩戴者进行电击，拥有轻度与重度两种模式。这种不可预测的刺激常被用作维持纪律与展示控制。解除束缚需要[高科技束具钥匙]，在解锁后还可通过[束具破解器]进行破解。破解后的项圈将不再随机电击，而是可由控制者手动触发，并自由选择电击模式。 -->
        <description>A control-oriented restraint specially designed by a space-age megacorporation, appearing as a metal collar fitted tightly around the neck. Its internal electrodes intermittently release electric currents to shock the wearer, featuring both mild and severe modes. This unpredictable stimulation is often used to maintain discipline and demonstrate control. Removal requires a [Spacer Restraint Key], and after unlocking, the device can be further decoded using a [Restraint Decryptor]. The decoded collar will no longer deliver random shocks but can be manually triggered by the controller, with free selection of shock mode.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_SlaveApparel/Mugirl_ShockCollar/Mugirl_ShockCollar</texPath>
        </graphicData>
        <costList>
            <ComponentIndustrial>2</ComponentIndustrial>
            <Steel>5</Steel>
        </costList>
        <statBases>
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>180</WorkToMake>
            <Mass>0.14</Mass>
            <EquipDelay>2.0</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.15</SlaveSuppressionOffset>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Neck</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_SlaveApparel/Mugirl_ShockCollar/Mugirl_ShockCollar</wornGraphicPath>
            <layers>
                <li>Mugirl_Neck_bondage</li>
            </layers>
            <drawData>
                <dataSouth>
                    <layer>100</layer>
                </dataSouth>
            </drawData>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>Electricity</researchPrerequisite>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smelt</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <recipeUsers>
                <li>ElectricTailoringBench</li>
                <li>HandTailoringBench</li>
                <li>TableMachining</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
            <displayPriority>260</displayPriority>
        </recipeMaker>
        <gives_bound_moodlet>true</gives_bound_moodlet>
        <blocks_hands>false</blocks_hands>
        <comps>
            <li Class="Mugirl.CompProperties_ShockCollar">
                <!-- 普通电击 -->
                <commonLabel>Common shock</commonLabel>
                <!-- 激活一次普通电击 -->
                <commonDesc>Trigger one common shock.</commonDesc>
                <commonIconPath>UI/ShockCollarCommon</commonIconPath>
                <!-- 强力电击 -->
                <powerLabel>Power shock</powerLabel>
                <!-- 激活一次强力电击，电死你！ -->
                <powerDesc>Trigger one power shock.</powerDesc>
                <powerIconPath>UI/ShockCollarPower</powerIconPath>
                <hediffDefs>
                    <li>Mugirl_EleShock</li>
                </hediffDefs>
                <powerhediffDefs>
                    <li>Mugirl_PowerEleShock</li>
                </powerhediffDefs>
                <nonMugirlPowerHediffDefs>
                    <li>Mugirl_PowerEleShock_NoMilk</li>
                </nonMugirlPowerHediffDefs>
                <ticks>1200</ticks>
                <useCooldownTicks>480</useCooldownTicks>
            </li>
        </comps>
    </Mugirl.SlaveApparelDef>

