    <!-- ====================================== 磁力镣铐  =========================================== -->

    <Mugirl.SlaveApparelDef ParentName="Mugirl_SlaveApparel_Spacer">
        <defName>Mugirl_MagneticShackles</defName>
        <!-- 雪牛娘 磁力镣铐 -->
        <label>Mugirl Magnetic Shackles</label>
        <!-- 由太空巨企开发的高科技束具，结合项圈与手铐组成。其内部磁力装置会不定时启动，将佩戴者的双手吸附到颈部，形成类似枷锁的姿态。这种设计带有明显的恶趣味，用以观赏雪牛娘在突然被束缚时的窘迫反应。解除束缚需要[高科技束具钥匙]，而在解锁后，该装置还可通过[束具破解器]进行破解。破解后的镣铐将不再自动启动，而是可以由控制者手动激活或解除。 -->
        <description>A high-tech restraint developed by a space-age megacorporation, combining a collar and handcuffs. Its internal magnetic mechanism activates intermittently, pulling the wearer's hands to the neck, forming a shackle-like posture. This design exhibits a distinct whimsicality, intended for observing the Mugirl's flustered reactions when suddenly restrained. Removal requires a [Spacer Restraint Key], and after unlocking, the device can be further decoded using a [Restraint Decryptor]. The decoded shackles will no longer activate automatically but can be manually activated or deactivated by the controller.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_SlaveApparel/Mugirl_MagneticShackle/Mugirl_MagneticShackle</texPath>
        </graphicData>
        <costList>
            <ComponentSpacer>6</ComponentSpacer>
            <Plasteel>150</Plasteel>
            <Uranium>50</Uranium>
        </costList>
        <statBases>
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>180</WorkToMake>
            <Mass>0.14</Mass>
            <EquipDelay>2.0</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.15</SlaveSuppressionOffset>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Neck</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_SlaveApparel/Mugirl_MagneticShackle/Mugirl_MagneticShackle</wornGraphicPath>
            <layers>
                <li>Mugirl_Neck_bondage</li>
            </layers>
            <!-- <drawData>
                <dataSouth>
                    <layer>100</layer>
                </dataSouth>
            </drawData> -->
        </apparel>
        <gives_bound_moodlet>true</gives_bound_moodlet>
        <comps>
            <li Class="Mugirl.CompProperties_MagneticShackles">
                <!-- 周期 tick 间隔 范围 -->
                <cycleInterval>15000~55000</cycleInterval>
                <!-- 束缚持续时间 范围 -->
                <bindDurationTicks>10000~20000</bindDurationTicks>
                <!-- 束缚时添加的 Hediff 列表 -->
                <bindHediffs>
                    <li>
                        <hediffDef>Mugirl_MagneticShacklesBondage</hediffDef>
                        <!-- bodyPartDef 可选，不填表示全身 -->
                        <bodyPartDefs>
                            <li>Arm</li>
                        </bodyPartDefs>
                    </li>
                </bindHediffs>
                <!-- 束缚的部位 -->
                <boundBodyPartGroupDefs>
                    <li>Arms</li>
                    <li>LeftHand</li>
                    <li>RightHand</li>
                </boundBodyPartGroupDefs>
                <!-- 主动按钮冷却时间 -->
                <useCooldownTicks>600</useCooldownTicks>
                <!-- 按钮文本与描述 -->
                <!-- 激活镣铐 -->
                <activateLabel>Activate shackles</activateLabel>
                <!-- 启动磁力镣铐，束缚目标。 -->
                <activateDesc>Activate the magnetic shackles, restraining the target.</activateDesc>
                <activateIconPath>UI/MagneticShackleLock</activateIconPath>
                <!-- 解除镣铐 -->
                <deactivateLabel>Release shackles</deactivateLabel>
                <!-- 解除磁力镣铐。 -->
                <deactivateDesc>Release the magnetic shackles.</deactivateDesc>
                <deactivateIconPath>UI/MagneticShackleUnLock</deactivateIconPath>
                <!-- 动态名字显示 -->
                <!-- 磁力镣铐（激活） -->
                <labelWhenActive>Magnetic shackles (active)</labelWhenActive>
                <!-- 磁力镣铐（未激活） -->
                <labelWhenInactive>Magnetic shackles (inactive)</labelWhenInactive>
                <!-- 提示与特效 -->
                <!-- 磁力手铐启动! -->
                <moteTextOn>Magnetic shackles activated!</moteTextOn>
                <!-- 磁力手铐解除! -->
                <moteTextOff>Magnetic shackles released!</moteTextOff>
                <!-- {0} 的磁力手铐突然启动了 -->
                <messageOn>{0}'s magnetic shackles suddenly activated.</messageOn>
                <!-- {0} 的磁力手铐被解除 -->
                <messageOff>{0}'s magnetic shackles were released.</messageOff>
                <!-- 激活音效  -->
                <activateSoundDefName>Mugirl_MagneticShackles_Work</activateSoundDefName>
            </li>
        </comps>
    </Mugirl.SlaveApparelDef>

    <!-- ====================================== 榨乳器 =========================================== -->

    <ThingDef ParentName="ApparelMakeableBase">
        <defName>Mugirl_MilkingDevice</defName>
        <!-- 雪牛娘 榨乳器 -->
        <label>Mugirl milking device</label>
        <!-- 一种面向雪牛娘设计的高科技榨乳设备。它会在雪牛娘产乳进度满时自动截留一次产奶，将其压缩储存在内部容器中。储能满后，可由穿戴者手动释放，集中生成雪牛奶。当前版本以功能优先，不包含按储能变化的专用贴图。 -->
        <description>A high-tech milking device designed for Mugirls. When the wearer's milk progress fills, it intercepts one production charge and compresses the milk into an internal container. Once storage is full, the wearer can manually release it to produce Mugirl milk in one batch. This version prioritizes function and does not include dedicated graphics for changing storage levels.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_MilkingDevice/Mugirl_MilkingDevice</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <modExtensions>
            <li Class="Mugirl.AdultContentExtension">
                <adultOnly>true</adultOnly>
            </li>
        </modExtensions>
        <thingCategories>
            <li>ApparelMisc</li>
        </thingCategories>
        <costList>
            <ComponentIndustrial>4</ComponentIndustrial>
            <Steel>25</Steel>
        </costList>
        <statBases>
            <MaxHitPoints>400</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>0.2</Mass>
            <StuffEffectMultiplierArmor>0.09</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.60</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.6</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
        </equippedStatOffsets>
        <recipeMaker>
            <researchPrerequisite>ComplexClothing</researchPrerequisite>
            <skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements>
            <displayPriority>255</displayPriority>
        </recipeMaker>
        <apparel>
            <tags>
                <li>Mugirl_Shell</li>
            </tags>
            <bodyPartGroups>
                <li>Torso</li>
            </bodyPartGroups>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <wornGraphicPath>Things/Apparel/Mugirl_MilkingDevice/Mugirl_MilkingDevice</wornGraphicPath>
            <layers>
                <li>Mugirl_Ornament</li>
            </layers>
        </apparel>
        <comps>
            <li Class="Mugirl.CompProperties_AdultContentControl" />
            <li Class="Mugirl.CompProperties_MilkingDeviceReleaseEffect">
                <durationTicks>30</durationTicks>
                <sounds>
                    <li>
                        <sound>Mugirl_Milking_Sound</sound>
                        <startTick>0</startTick>
                        <loopInterval>30</loopInterval>
                        <endTick>0</endTick>
                    </li>
                </sounds>
            </li>
            <li Class="Mugirl.CompProperties_MilkingDevice">
                <maxCharges>3</maxCharges>
                <!-- 释放储乳 -->
                <releaseLabel>Release stored milk</releaseLabel>
                <releaseDesc></releaseDesc>
                <releaseIconPath>UI/Mugirl_Charge</releaseIconPath>
                <!-- 储乳层数 -->
                <inspectLabel>Stored milk charges</inspectLabel>
                <!-- 当前没有可释放的储乳。 -->
                <noChargeText>There is no stored milk to release.</noChargeText>
                <releaseMessageKey></releaseMessageKey>
                <storedMessageKey></storedMessageKey>
                <storedMoteText></storedMoteText>
                <releaseThingDefName>Mugirl_Milk</releaseThingDefName>
                <spawnFilthOnRelease>true</spawnFilthOnRelease>
                <filthDefName>MugirlMilkStain</filthDefName>
                <spawnFilthInFacingDirection>true</spawnFilthInFacingDirection>
                <filthCountRange>
                    <min>1</min>
                    <max>2</max>
                </filthCountRange>
                <releaseSounds>
                    <li>Mugirl_Milking_Sound</li>
                </releaseSounds>
                <powerReleaseSounds>
                    <li>Mugirl_Milking_Power_Sound</li>
                </powerReleaseSounds>
                <powerFilthDefName></powerFilthDefName>
            </li>
        </comps>
    </ThingDef>

