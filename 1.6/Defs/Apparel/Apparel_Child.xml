        <graphicData>
            <texPath>Things/Apparel/MooGirl_ChildCheongsam/MooGirl_ChildCheongsam</texPath>
        </graphicData>
        <costStuffCount>70</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>160</MaxHitPoints>
            <WorkToMake>7000</WorkToMake>
            <Mass>1.7</Mass>
            <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.80</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.30</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/MooGirl_ChildCheongsam/MooGirl_ChildCheongsam</wornGraphicPath>
            <useWornGraphicMask>false</useWornGraphicMask>
        </apparel>
    </ThingDef>
</Defs>