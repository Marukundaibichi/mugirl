    <ThingDef ParentName="MooGirl_ChildBase">
        <defName>MooGirl_ChildCheongsam</defName>
        <!-- 雪牛娘 儿童旗袍 「皎月裁云」 -->
        <label>Mugirl Child Cheongsam "Cloud-Cut Bright Moon"</label>
        <!-- 「八重·朱 服装」出品高开衩真丝旗袍，纷繁花绣衬出超低胸襟。东方美学与现代性感碰撞，化身移动的纯白焦点。 -->
