	<!-- ====================================== 磁力镣铐  =========================================== -->

	<MooGirl.SlaveApparelDef ParentName="MooGirl_SlaveApparel_Spacer">
		<defName>MooGirl_MagneticShackles</defName>
		<label>雪牛娘 磁力镣铐</label>
		<description>由太空巨企开发的高科技束具，结合项圈与手铐组成。其内部磁力装置会不定时启动，将佩戴者的双手吸附到颈部，形成类似枷锁的姿态。这种设计带有明显的恶趣味，用以观赏雪牛娘在突然被束缚时的窘迫反应。解除束缚需要[高科技束具钥匙]，而在解锁后，该装置还可通过[束具破解器]进行破解。破解后的镣铐将不再自动启动，而是可以由控制者手动激活或解除。</description>
		<graphicData>
			<texPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_MagneticShackle/MooGirl_MagneticShackle</texPath>
		</graphicData>
		<costList>
			<ComponentSpacer>6</ComponentSpacer>
			<Plasteel>150</Plasteel>
			<Uranium>50</Uranium>
		</costList>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToMake>180</WorkToMake>
			<Mass>0.14</Mass>
			<EquipDelay>2.0</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.15</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Neck</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_MagneticShackle/MooGirl_MagneticShackle</wornGraphicPath>
			<layers>
				<li>MooGirl_Neck_bondage</li>
			</layers>
			<!-- <drawData>
    		    <dataSouth>
                    <layer>100</layer>
       			</dataSouth>
            </drawData> -->
		</apparel>
		<gives_bound_moodlet>true</gives_bound_moodlet>
		<comps>
			<li Class="MooGirl.CompProperties_MagneticShackles">
				<!-- 周期 tick 间隔 范围 -->
				<cycleInterval>15000~55000</cycleInterval>
				<!-- 束缚持续时间 范围 -->
				<bindDurationTicks>10000~20000</bindDurationTicks>
				<!-- 束缚时添加的 Hediff 列表 -->
				<bindHediffs>
					<li>
						<hediffDef>MooGirl_MagneticShacklesBondage</hediffDef>
						<!-- bodyPartDef 可选，不填表示全身 -->
    					<bodyPartDefs>
							<li>Arm</li>
  				    	</bodyPartDefs>
					</li>
				</bindHediffs>
				<!-- 束缚的部位 -->
				<boundBodyPartGroupDefs>
					<li>Arms</li>
					<li>LeftHand</li>
					<li>RightHand</li>
				</boundBodyPartGroupDefs>
				<!-- 主动按钮冷却时间 -->
				<useCooldownTicks>600</useCooldownTicks>
				<!-- 按钮文本与描述 -->
				<activateLabel>激活镣铐</activateLabel>
				<activateDesc>启动磁力镣铐，束缚目标。</activateDesc>
				<activateIconPath>UI/MagneticShackleLock</activateIconPath>
				<deactivateLabel>解除镣铐</deactivateLabel>
				<deactivateDesc>解除磁力镣铐。</deactivateDesc>
				<deactivateIconPath>UI/MagneticShackleUnLock</deactivateIconPath>
				<!-- 动态名字显示 -->
				<labelWhenActive>磁力镣铐（激活）</labelWhenActive>
				<labelWhenInactive>磁力镣铐（未激活）</labelWhenInactive>
				<!-- 提示与特效 -->
				<moteTextOn>磁力手铐启动!</moteTextOn>
				<moteTextOff>磁力手铐解除!</moteTextOff>
				<messageOn>{0} 的磁力手铐突然启动了</messageOn>
				<messageOff>{0} 的磁力手铐被解除</messageOff>
				<!-- 激活音效  -->
				<activateSoundDefName>MooGirl_MagneticShackles_Work</activateSoundDefName>
			</li>
		</comps>
	</MooGirl.SlaveApparelDef>

	<!-- ====================================== 电击项圈 =========================================== -->

	<ThingDef ParentName="ApparelMakeableBase">
		<defName>MooGirl_MilkingDevice</defName>
		<label>雪牛娘 榨乳器</label>
		<description>一种面向雪牛娘设计的高科技榨乳设备。它会在雪牛娘产乳进度满时自动截留一次产奶，将其压缩储存在内部容器中。储能满后，可由穿戴者手动释放，集中生成雪牛奶。当前版本以功能优先，不包含按储能变化的专用贴图。</description>
		<graphicData>
			<texPath>Things/Apparel/MooGirl_MilkingDevice/MooGirl_MilkingDevice</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<techLevel>Spacer</techLevel>
		<modExtensions>
			<li Class="MooGirl.AdultContentExtension">
				<adultOnly>true</adultOnly>
			</li>
		</modExtensions>
		<thingCategories>
			<li>ApparelMisc</li>
		</thingCategories>
		<costList>
			<ComponentIndustrial>4</ComponentIndustrial>
			<Steel>25</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToMake>4000</WorkToMake>
			<Mass>0.2</Mass>
			<StuffEffectMultiplierArmor>0.09</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.60</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.6</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SocialImpact>0.2</SocialImpact>
		</equippedStatOffsets>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
			<skillRequirements>
				<Crafting>3</Crafting>
			</skillRequirements>
			<displayPriority>255</displayPriority>
		</recipeMaker>
		<apparel>
			<tags>
				<li>MooGirl_Shell</li>
			</tags>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<wornGraphicPath>Things/Apparel/MooGirl_MilkingDevice/MooGirl_MilkingDevice</wornGraphicPath>
			<layers>
				<li>MooGirl_Ornament</li>
			</layers>
		</apparel>
		<comps>
			<li Class="MooGirl.CompProperties_AdultContentControl" />
			<li Class="MooGirl.CompProperties_MilkingDeviceReleaseEffect">
				<durationTicks>30</durationTicks>
				<sounds>
					<li>
						<sound>MooGirl_Milking_Sound</sound>
						<startTick>0</startTick>
						<loopInterval>30</loopInterval>
						<endTick>0</endTick>
					</li>
				</sounds>
			</li>
			<li Class="MooGirl.CompProperties_MilkingDevice">
				<maxCharges>3</maxCharges>
				<releaseLabel>释放储乳</releaseLabel>
				<releaseDesc></releaseDesc>
				<releaseIconPath>UI/MooGirl_Charge</releaseIconPath>
				<inspectLabel>储乳层数</inspectLabel>
				<noChargeText>当前没有可释放的储乳。</noChargeText>
				<releaseMessageKey></releaseMessageKey>
				<storedMessageKey></storedMessageKey>
				<storedMoteText></storedMoteText>
				<releaseThingDefName>MooGirl_Milk</releaseThingDefName>
				<spawnFilthOnRelease>true</spawnFilthOnRelease>
				<filthDefName>MooGirlMilkFilth</filthDefName>
				<spawnFilthInFacingDirection>true</spawnFilthInFacingDirection>
				<filthCountRange>
					<min>1</min>
					<max>2</max>
				</filthCountRange>
				<releaseSounds>
					<li>MooGirl_Milking_Sound</li>
				</releaseSounds>
				<powerReleaseSounds>
					<li>MooGirl_Milking_Power_Sound</li>
				</powerReleaseSounds>
				<powerFilthDefName></powerFilthDefName>
			</li>
		</comps>
	</ThingDef>

