	<MooGirl.SlaveApparelDef ParentName="MooGirl_SlaveApparel_Spacer">
		<defName>MooGirl_ShockCollar</defName>
		<label>雪牛娘 电击项圈</label>
		<description>由太空巨企专门设计的控制型束具，外观为紧贴在颈部的金属项圈。其内部电极会不定期释放电流，对佩戴者进行电击，拥有轻度与重度两种模式。这种不可预测的刺激常被用作维持纪律与展示控制。解除束缚需要[高科技束具钥匙]，在解锁后还可通过[束具破解器]进行破解。破解后的项圈将不再随机电击，而是可由控制者手动触发，并自由选择电击模式。</description>
		<graphicData>
			<texPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_ShockCollar/MooGirl_ShockCollar</texPath>
		</graphicData>
		<costList>
			<ComponentSpacer>6</ComponentSpacer>
			<Plasteel>150</Plasteel>
			<Uranium>50</Uranium>
		</costList>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToMake>180</WorkToMake>
			<Mass>0.14</Mass>
			<EquipDelay>2.0</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.15</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Neck</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_ShockCollar/MooGirl_ShockCollar</wornGraphicPath>
			<layers>
				<li>MooGirl_Neck_bondage</li>
			</layers>
			<drawData>
    		    <dataSouth>
                    <layer>100</layer>
       			</dataSouth>
            </drawData>
		</apparel>
		<recipeMaker>
			<displayPriority>260</displayPriority>
		</recipeMaker>
		<gives_bound_moodlet>true</gives_bound_moodlet>
		<blocks_hands>false</blocks_hands>
		<comps>
			<li Class="MooGirl.CompProperties_ShockCollar">
				<commonLabel>普通电击</commonLabel>
				<commonDesc>激活一次普通电击</commonDesc>
				<commonIconPath>UI/ShockCollarCommon</commonIconPath>
				<powerLabel>强力电击</powerLabel>
