	<ThingDef ParentName="MooGirl_Base_SlaveApperalKey">
		<defName>MooGirl_SlaveApperalKey_Medieval</defName>
		<label>粗糙束具钥匙</label>
		<description>用于解锁雪牛娘束具的钥匙，加工较粗糙，只能用来解锁较低级的束具。</description>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Flammability>0.2</Flammability>
			<DeteriorationRate>0.5</DeteriorationRate>
			<Beauty>0</Beauty>
			<MarketValue>10</MarketValue>
			<Mass>0.1</Mass>
		</statBases>
		<graphicData>
			<texPath>Things/Item/Keys/SlaveApperalKey_Medieval</texPath>
		</graphicData>
		<techLevel>Medieval</techLevel>
	</ThingDef>

