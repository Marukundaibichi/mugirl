	<MooGirl.SlaveApparelDef ParentName="MooGirl_SlaveApparel_Shell_Lower">
		<defName>MooGirl_Slaveboots</defName>
		<label>雪牛娘 奴隶靴</label>
		<description>一种高跟鞋型的束缚靴，限制其移动速度。穿戴者无法自行脱下，但步态似乎变得更加优雅。配合特质的奴隶袜会进一步强化束缚，这下无论对雪牛娘做什么她都无法反抗力。束具配有专用锁具，必须使用[粗糙束具钥匙]才能解开。</description>
		<graphicData>
			<texPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_Slaveboots/MooGirl_Slaveboots</texPath>
		</graphicData>
		<costStuffCount>180</costStuffCount>
		<statBases>
			<MaxHitPoints>160</MaxHitPoints>
			<WorkToMake>10000</WorkToMake>
			<Mass>10</Mass>
			<StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.10</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.8</EquipDelay>
		</statBases>
		<apparel>
			<wornGraphicPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_Slaveboots/MooGirl_Slaveboots</wornGraphicPath>
		</apparel>
	</MooGirl.SlaveApparelDef>

