<?xml version="1.0" encoding="utf-8"?>

<Defs>
	<MooGirl.SlaveApparelDef Name="MooGirl_SlaveApparel_Shell"
		ParentName="MooGirl_SlaveApparel_Base" Abstract="True">
		<recipeMaker>
			<researchPrerequisite>FlakArmor</researchPrerequisite>
			<displayPriority>260</displayPriority> <!-- 配方显示优先级 -->
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      		<workSkill>Crafting</workSkill>
     		<recipeUsers>
        		<li>ElectricTailoringBench</li>
        		<li>HandTailoringBench</li>
     		</recipeUsers>
     	 	<skillRequirements>
        		<Crafting>6</Crafting>
      		</skillRequirements>
			<effectWorking>Smelt</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
  		</recipeMaker>
		<descriptionHyperlinks>
			<ThingDef>MooGirl_SlaveApperalKey_Medieval</ThingDef>
		</descriptionHyperlinks>
		<graphicData>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
		</apparel>
		<needkeynumber>2</needkeynumber> <!-- 解锁需求钥匙数量 -->
		<keytype>MooGirl_SlaveApperalKey_Medieval</keytype> <!-- 钥匙类型 -->
		<gives_bound_moodlet>true</gives_bound_moodlet>
	</MooGirl.SlaveApparelDef>

	<!-- ====================================== 上半身束具 =========================================== -->

	<MooGirl.SlaveApparelDef Name="MooGirl_SlaveApparel_Shell_Upper"
		ParentName="MooGirl_SlaveApparel_Shell" Abstract="True">
		<apparel>
			<bodyPartGroups>
				<li>Arms</li>
				<li>LeftHand</li>
				<li>RightHand</li>
			</bodyPartGroups>
			<layers>
				<li>MooGirl_Arm_bondage</li>
			</layers>
			<tags> <!-- 自定义标签，可用于pankind生成 -->
				<li>MooGirl_Slave_Shell_Upper</li>
			</tags>
		</apparel>
		<!-- <descriptionHyperlinks>
			<HediffDef>MooGirl_Armbinder</HediffDef>
		</descriptionHyperlinks> -->
		<stuffCategories>
			<li>Leathery</li>
			<li>Metallic</li>
		</stuffCategories>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.35</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<blocks_hands>true</blocks_hands>
		<HediffTargetBodyPartDefs>
			<li>Arm</li>
		</HediffTargetBodyPartDefs>
		<BoundBodyPartGroupDefs>
			<li>Arms</li>
			<li>LeftHand</li>
			<li>RightHand</li>
		</BoundBodyPartGroupDefs>
		<NextSlaveApperalDefs>
			<li>MooGirl_Slavegauntlet</li>
		</NextSlaveApperalDefs>
	</MooGirl.SlaveApparelDef>

	<MooGirl.SlaveApparelDef ParentName="MooGirl_SlaveApparel_Shell_Upper">
		<defName>MooGirl_Boxbinder</defName>
		<label>雪牛娘 手臂束具</label>
		<description>一种专门限制雪牛娘手臂的奴隶束具，多重手铐与皮带将雪牛娘的双手束缚在身后，配合特质的奴隶手套甚至连手指都无法活动，这下无论对雪牛娘做什么她都无法反抗力。束具配有专用锁具，必须使用[粗糙束具钥匙]才能解开。</description>
		<graphicData>
			<texPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_Slaveclothes/MooGirl_Slaveclothes</texPath>
		</graphicData>
		<costStuffCount>180</costStuffCount>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>10000</WorkToMake>
			<Mass>10</Mass>
			<StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.10</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.8</EquipDelay>
		</statBases>
		<apparel>
			<wornGraphicPath>Things/Apparel/MooGirl_SlaveApparel/MooGirl_Slaveclothes/MooGirl_Slaveclothes</wornGraphicPath>
		</apparel>
	    <equipped_hediff>MooGirl_Boxbinder</equipped_hediff>
	</MooGirl.SlaveApparelDef>

