<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- PMC钢盔 -->
    <ThingDef ParentName="ApparelMakeableBase">
        <defName>PMC_Helmet</defName>
        <!-- PMC钢盔 -->
        <label>PMC Helmet</label>
        <!-- PMC佣兵的标准钢盔，保护头部和耳朵。 -->
        <description>A standard helmet for PMC mercenaries, protecting the head and ears.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/Enemyarmor/pmc_helmet/pmc_helmet</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <costStuffCount>30</costStuffCount>
        <stuffCategories Inherit="False">
            <li>Metallic</li>
        </stuffCategories>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>7</ComponentIndustrial>
        </costList>
        <statBases>
            <MaxHitPoints>110</MaxHitPoints>
            <MarketValue>500</MarketValue>
            <WorkToMake>567</WorkToMake>
            <Mass>2</Mass>
            <Flammability>0.5</Flammability>
            <Beauty>-3</Beauty>
            <DeteriorationRate>2.0</DeteriorationRate>
            <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
            <ArmorRating_Heat>0.3</ArmorRating_Heat>
            <Insulation_Cold>4</Insulation_Cold>
            <Insulation_Heat>2</Insulation_Heat>
            <EquipDelay>5</EquipDelay>
            <SellPriceFactor>0.2</SellPriceFactor>
        </statBases>
        <apparel>
            <layers>
                <li>Overhead</li>
            </layers>
            <bodyPartGroups>
                <li>FullHead</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Equipment/Enemyarmor/pmc_helmet/pmc_helmet</wornGraphicPath>
            <tags>
                <li>PMC</li>
                <li>IndustrialMilitaryBasic</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>FlakArmor</researchPrerequisite>
            <recipeUsers>
                <li>TableMachining</li>
                <li>ElectricTailoringBench</li>
                <li>HandTailoringBench</li>
            </recipeUsers>
        </recipeMaker>
        <thingCategories>
            <li>ArmorHeadgear</li>
        </thingCategories>
    </ThingDef>

