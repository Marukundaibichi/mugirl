    <ThingDef ParentName="Mugirl_ArmorBase">
        <defName>Mugirl_ReconArmor</defName>
        <!-- 雪牛娘 特化防弹钢甲 -->
        <label>Mugirl Recon Armour "Rapidité Écarlate"</label>
        <!-- 胸口和背部插有装甲板的背心，对牛娘胸部进行特化。主要保护躯干与主要器官，没有四肢防御能力 -->
        <description>Vache Rousse presents lightweight reconnaissance armour, providing protection for the torso's key areas.\nIt achieves a perfect balance between defence and provocation; distracting the enemy is itself a strategy.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_ReconArmor/Mugirl_ReconArmor</texPath>
        </graphicData>
        <techLevel>Industrial</techLevel>
        <equippedStatOffsets>
            <MoveSpeed>0.25</MoveSpeed>
        </equippedStatOffsets>
        <costList>
            <ComponentIndustrial>3</ComponentIndustrial>
            <Steel>80</Steel>
        </costList>
        <apparel>
            <layers>
                <li>Middle</li>
            </layers>
            <wornGraphicPath>Things/Apparel/Mugirl_ReconArmor/Mugirl_ReconArmor</wornGraphicPath>
            <tags>
                <li>Mugirl_Armor</li>
            </tags>
            <drawData>
                <dataNorth>
                    <layer>60</layer>
                </dataNorth>
            </drawData>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
            </bodyPartGroups>
        </apparel>
        <statBases>
            <WorkToMake>45000</WorkToMake>
            <MaxHitPoints>280</MaxHitPoints>
            <Mass>9</Mass>
            <Flammability>0.4</Flammability>
            <ArmorRating_Sharp>0.92</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
            <ArmorRating_Heat>0.46</ArmorRating_Heat>
            <Insulation_Cold>64</Insulation_Cold>
            <Insulation_Heat>9</Insulation_Heat>
            <EquipDelay>11</EquipDelay>
        </statBases>
    </ThingDef>

