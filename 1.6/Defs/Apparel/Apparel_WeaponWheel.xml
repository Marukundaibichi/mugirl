<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ApparelBase">
        <defName>Mugirl_AutoloadingSystem</defName>
        <!-- 自驱装弹系统 -->
        <label>self-propelled autoloading system</label>
        <!-- 为雪牛娘武器轮盘设计的重型腰挂装填机构。火力满载期间，它会自动处理全部武器，从而取消两轮齐射之间的累计装弹时间，但不会加快实际的武器切换动作。 -->
        <description>A heavy waist-mounted loading mechanism designed for a Mugirl weapon wheel. During full-firepower operation it services every weapon automatically, eliminating the combined reload pause between volleys. It does not accelerate the physical weapon-switching sequence.</description>
        <techLevel>Spacer</techLevel>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_AutoloadingSystem/Mugirl_AutoloadingSystem</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.75</drawSize>
        </graphicData>
        <uiIconPath>Things/Apparel/Mugirl_AutoloadingSystem/Mugirl_AutoloadingSystem</uiIconPath>
        <statBases>
            <MaxHitPoints>160</MaxHitPoints>
            <Mass>8</Mass>
            <WorkToMake>36000</WorkToMake>
            <Flammability>0.2</Flammability>
            <EquipDelay>3</EquipDelay>
        </statBases>
        <costList>
            <Plasteel>80</Plasteel>
            <ComponentIndustrial>6</ComponentIndustrial>
            <ComponentSpacer>2</ComponentSpacer>
        </costList>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <careIfDamaged>false</careIfDamaged>
            <wearPerDay>0</wearPerDay>
            <bodyPartGroups>
                <li>Waist</li>
            </bodyPartGroups>
            <layers>
                <li>Belt</li>
            </layers>
            <tags>
                <li>MugirlAutoloadingSystem</li>
            </tags>
        </apparel>
        <comps>
            <li Class="Mugirl.CompProperties_AutoloadingSystem">
                <skipCycleReload>true</skipCycleReload>
            </li>
        </comps>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedBelt</unfinishedThingDef>
            <researchPrerequisite>Mugirl_Autoloading</researchPrerequisite>
            <recipeUsers>
                <li>FabricationBench</li>
            </recipeUsers>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
            <displayPriority>315</displayPriority>
        </recipeMaker>
        <thingCategories>
            <li>ApparelUtility</li>
        </thingCategories>
        <tradeTags>
            <li>Armor</li>
        </tradeTags>
        <smeltable>true</smeltable>
    </ThingDef>
</Defs>
