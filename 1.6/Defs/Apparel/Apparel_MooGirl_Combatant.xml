      <Insulation_Cold>-5</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
      <SellPriceFactor>0.2</SellPriceFactor>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
