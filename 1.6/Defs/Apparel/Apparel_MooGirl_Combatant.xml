  <!-- 雪牛娘战斗员防弹衣 - Shell -->
  <ThingDef ParentName="MooGirl_ArmorBase">
    <defName>MooGirl_Combatant_BulletproofVest</defName>
    <!-- 雪牛娘战斗员防弹衣 -->
    <label>Mugirl Combatant Bulletproof Vest</label>
    <!-- 雪牛娘战斗员专用的防弹护甲，提供优秀的利器防护。 -->
    <description>Bulletproof armor for Mugirl combatants, providing excellent sharp protection.</description>
    <graphicData>
      <texPath>Things/Apparel/MooGirl_combatant_bulletproofvest/MooGirl_combatant_bulletproofvest</texPath>
    </graphicData>
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>30</costStuffCount>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>7</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>110</MaxHitPoints>
      <MarketValue>500</MarketValue>
      <WorkToMake>567</WorkToMake>
      <Mass>2</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-3</Beauty>
      <DeteriorationRate>2.0</DeteriorationRate>
      <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0.3</ArmorRating_Heat>
      <Insulation_Cold>-5</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
      <StuffEffectMultiplierArmor>1.0</StuffEffectMultiplierArmor>
      <SellPriceFactor>0.2</SellPriceFactor>
    </statBases>
    <apparel>
      <layers>
        <li>Shell</li>
      </layers>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/MooGirl_combatant_bulletproofvest/MooGirl_combatant_bulletproofvest</wornGraphicPath>
      <tags>
        <li>MooGirl_Combatant</li>
        <li>MooGirl_Combatant_OptionalVest</li>
      </tags>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>FlakArmor</researchPrerequisite>
      <recipeUsers>
        <li>TableMachining</li>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

