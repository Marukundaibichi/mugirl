  <!-- 雪牛娘全套军礼服 - OnSkin -->
  <ThingDef ParentName="MooGirl_OnSkinBase">
    <defName>MooGirl_MilitaryDress</defName>
    <!-- 雪牛娘全套军礼服 -->
    <label>Mugirl Full Military Dress Uniform</label>
    <!-- 装备设计局于5495年定型的全套雪牛娘制式军礼服，通体采用先进军用合成纤维面料加工而成，实现了经久耐用与体面修身的平衡，且因优越的防风保温性能广受称赞。该型军礼服覆盖全身，其附带的记忆面料能快速适应身体曲线，改善外观气质。在雪牛娘武装力量当中，该型军礼服正逐步取代老式条例，成为新时代正式场合的标准配置。 -->
    <description>A full Mugirl regulation military dress uniform finalized by the Equipment Design Bureau in 5495. Made throughout from advanced military synthetic fibers, it balances durability with a dignified tailored fit and is praised for its excellent windproof warmth. This model covers the whole body, and its memory fabric quickly adapts to body contours to improve appearance. Within Mugirl armed forces, it is gradually replacing older regulations as the standard for formal occasions.</description>
    <graphicData>
      <texPath>Things/Apparel/MooGirl_Militarydress/MooGirl_Militarydress</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>30</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>7</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>110</MaxHitPoints>
      <MarketValue>500</MarketValue>
      <WorkToMake>567</WorkToMake>
      <Mass>2</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-3</Beauty>
      <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0.3</ArmorRating_Heat>
      <Insulation_Cold>-5</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
      <SellPriceFactor>0.2</SellPriceFactor>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/MooGirl_Militarydress/MooGirl_Militarydress</wornGraphicPath>
      <tags>
        <li>MooGirl_Combatant</li>
      </tags>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
      <recipeUsers>
        <li>TableMachining</li>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <!-- 雪牛娘轻量化军礼服 - OnSkin -->
  <ThingDef ParentName="MooGirl_OnSkinBase">
    <defName>MooGirl_MilitaryUniform</defName>
    <!-- 雪牛娘轻量化军礼服 -->
    <label>Mugirl Lightweight Military Dress Uniform</label>
    <!-- 装备设计局于5495年定型的轻量化雪牛娘制式军礼服，通体采用先进军用合成纤维面料加工而成，实现了经久耐用与体面修身的平衡，且因优越的透气散热性能广受称赞。为与贴身衣物契合，该型军服在躯干处做出镂空妥协，其附带的记忆面料能快速适应身体曲线，改善外观气质。在雪牛娘武装力量当中，该型军礼服正逐步取代老式条例，成为新时代正式场合的标准配置。 -->
    <description>A lightweight Mugirl regulation military dress uniform finalized by the Equipment Design Bureau in 5495. Made throughout from advanced military synthetic fibers, it balances durability with a dignified tailored fit and is praised for its excellent breathability and heat dissipation. To better fit close-worn garments, this model compromises with cutouts around the torso, while its memory fabric quickly adapts to body contours to improve appearance. Within Mugirl armed forces, it is gradually replacing older regulations as the standard for formal occasions.</description>
    <graphicData>
      <texPath>Things/Apparel/MooGirl_militaryuniform/MooGirl_militaryuniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>30</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
