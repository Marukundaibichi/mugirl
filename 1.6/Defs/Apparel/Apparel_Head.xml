<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ====================================== 头部装饰 =========================================== -->

    <ThingDef Name="Mugirl_HeadBase" ParentName="HatMakeableBase" Abstract="True">
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <Mass>0.4</Mass>
            <EquipDelay>2.0</EquipDelay>
        </statBases>
        <apparel>
            <layers>
                <li>Overhead</li>
            </layers>
            <renderSkipFlags>
                <li>None</li>
            </renderSkipFlags>
            <tags>
                <li>Mugirl_Head</li>
            </tags>
            <useWornGraphicMask>true</useWornGraphicMask>
        </apparel>
        <thingCategories>
            <li>Mugirl_Head</li>
        </thingCategories>
        <recipeMaker>
            <researchPrerequisite>ComplexClothing</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <ThingDef ParentName="Mugirl_HeadBase">
        <defName>Mugirl_BunnyGirlHeaddress</defName>
        <!-- 雪牛娘 兔女郎头饰 「魅夜绒耳」 -->
        <label>Mugirl Bunny Girl Headdress "Velours Nocturne Envoûtant"</label>
        <!-- 标志性黑色短绒长耳头饰，光洁材质折射出性感俏皮。两只长耳伴随歌舞肆意摇曳，是灯红酒绿之时的风情乍泄。 -->
        <description>A signature black short-pile long ear headdress.\nThe lustrous material reflects a playful yet sensual charm.\nThese long ears sway freely with song and dance, capturing a moment of coquettish allure amidst shimmering lights and flowing wine.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_BunnyGirlHeaddress/Mugirl_BunnyGirlHeaddress</texPath>
        </graphicData>
        <costStuffCount>50</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
        </equippedStatOffsets>
        <statBases>
            <MaxHitPoints>120</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>HeadAttackTool</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_BunnyGirlHeaddress/Mugirl_BunnyGirlHeaddress</wornGraphicPath>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="Mugirl_HeadBase">
        <defName>Mugirl_Sunglasses</defName>
        <!-- 雪牛娘 墨镜 「霓虹幻镜」 -->
        <label>Mugirl Sunglasses "Reflet Néon Illusoire"</label>
        <!-- 复古圆框夹鼻墨镜，小巧玲珑遮不住眉目传情。抵御强光时保持时尚气场，是大隐于市的必备潮流单品。 -->
        <description>Retro round-frame pinch-on sunglasses, petite yet unable to conceal expressive glances.\nThey maintain a fashionable poise while shielding against glare, an essential urban accessory for the discerning individual.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_Sunglasses/Mugirl_Sunglasses</texPath>
        </graphicData>
        <costList>
            <Steel>25</Steel>
        </costList>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
        </equippedStatOffsets>
        <statBases>
            <MaxHitPoints>65</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>0.1</Mass>
            <EquipDelay>0.5</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>HeadAttackTool</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_Sunglasses/Mugirl_Sunglasses</wornGraphicPath>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="Mugirl_HeadBase">
        <defName>Mugirl_Veil</defName>
        <!-- 雪牛娘 面纱 -->
        <label>Mugirl Veil</label>
        <!-- 复古轻纱面纱，薄若晨雾，垂落生姿，若隐若现却不掩眉眼风情。在遮挡目光与保留魅力之间取得微妙平衡，行走于人群中自成气场。不张扬，却自带故事感，是大隐于市、低调出挑的风格点睛之物。 -->
        <description>A retro light-gauze veil, as thin as morning mist and falling with graceful poise. It hints without hiding the charm of the eyes, striking a subtle balance between concealment and allure. In a crowd it carries its own quiet presence, understated yet full of story, a finishing touch for standing out while staying discreet.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_Veil/Mugirl_Veil</texPath>
        </graphicData>
        <costStuffCount>20</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
        </equippedStatOffsets>
        <statBases>
            <MaxHitPoints>25</MaxHitPoints>
            <WorkToMake>2000</WorkToMake>
            <Mass>0.1</Mass>
            <EquipDelay>0.1</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>HeadAttackTool</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_Veil/Mugirl_Veil</wornGraphicPath>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="Mugirl_HeadBase">
        <defName>Mugirl_Mask</defName>
        <!-- 雪牛娘 口罩 -->
        <label>Mugirl Gauze Mask</label>
        <!-- 轻纱口罩，轻覆唇颌，似遮非遮。它并非为了隔绝世界，而是为隐藏未被言说的表情与秘密。在人群之中保留分寸感，让真正的意图只留给懂的人。 -->
        <description>A light-gauze mask resting gently over the lips and jaw as if both concealing and revealing. It is not meant to shut the world out, but to hide unspoken expressions and secrets. Among a crowd it preserves a measured distance, leaving true intentions only for those who understand.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_Mask/Mugirl_Mask</texPath>
        </graphicData>
        <costStuffCount>20</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
        </equippedStatOffsets>
        <statBases>
            <MaxHitPoints>25</MaxHitPoints>
            <WorkToMake>2000</WorkToMake>
            <Mass>0.1</Mass>
            <EquipDelay>0.1</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>HeadAttackTool</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_Mask/Mugirl_Mask</wornGraphicPath>
        </apparel>
    </ThingDef>

    <!-- ====================================== 头盔 =========================================== -->

    <ThingDef Name="Mugirl_ArmorHelmetBase" ParentName="Mugirl_HeadBase"
        Abstract="True">
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <researchPrerequisite>FlakArmor</researchPrerequisite>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>TableMachining</li>
            </recipeUsers>
        </recipeMaker>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tradeTags>
            <li>HiTechArmor</li>
        </tradeTags>
        <thingCategories>
            <li>ArmorHeadgear</li>
        </thingCategories>
        <generateCommonality>2</generateCommonality>
        <statBases>
            <WorkToMake>15750</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Mass>1</Mass>
            <Flammability>0.4</Flammability>
            <ArmorRating_Sharp>0.92</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
            <ArmorRating_Heat>0.46</ArmorRating_Heat>
            <Insulation_Cold>4</Insulation_Cold>
            <Insulation_Heat>2</Insulation_Heat>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.65</VacuumResistance>
        </equippedStatOffsets>
        <apparel>
            <parentTagDef>ApparelHead</parentTagDef>
            <bodyPartGroups>
                <li>FullHead</li>
            </bodyPartGroups>
            <layers>
                <li>Overhead</li>
            </layers>
            <defaultOutfitTags>
                <li>Soldier</li>
                <li>Spacefarer</li>
            </defaultOutfitTags>
            <useDeflectMetalEffect>true</useDeflectMetalEffect>
            <tags>
                <li>Mugirl_Helmet</li>
            </tags>
        </apparel>
        <colorGenerator Class="ColorGenerator_Options">
            <options>
                <li>
                    <weight>10</weight>
                    <only>(0.9,0.9,0.9,1)</only>
                </li>
                <li>
                    <weight>10</weight>
                    <only>(0.33,0.33,0.33,1)</only>
                </li>
                <li>
                    <weight>10</weight>
                    <only>(0.65,0.65,0.65,1)</only>
                </li>
                <li>
                    <weight>6</weight>
                    <min>(0.3,0.3,0.3,1)</min>
                    <max>(0.5,0.5,0.5,1)</max>
                </li>
            </options>
        </colorGenerator>
        <comps>
            <li Class="CompProperties_Biocodable" />
        </comps>
        <thingSetMakerTags>
            <li>RewardStandardHighFreq</li>
        </thingSetMakerTags>
    </ThingDef>

    <ThingDef ParentName="Mugirl_ArmorHelmetBase">
        <defName>Mugirl_ArmorHelmetRecon</defName>
        <!-- 雪牛娘 革命军钢盔 -->
        <label>Mugirl Recon Helmet "Énigme de l'Ombre du Papillon"</label>
        <!-- 简化设计的雪牛娘特制钢盔，拥有伪装网用于伪装，留有两个凹槽来存放角。搭配蝴蝶结和革命军金属徽章 -->
        <description>A lightweight streamlined helmet with a dusky pink fabric lining for comfort.\nThis piece represents a fusion of tactical functionality and aesthetic appeal.\nA bow, glimpsed in the darkness, blooms with a lethal allure.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_ArmorHelmetRecon/Mugirl_ArmorHelmetRecon</texPath>
        </graphicData>
        <costList>
            <Steel>45</Steel>
        </costList>
        <apparel>
            <wornGraphicPath>Things/Apparel/Mugirl_ArmorHelmetRecon/Mugirl_ArmorHelmetRecon</wornGraphicPath>
            <forceEyesVisibleForRotations>
                <li>1</li>
                <li>2</li>
                <li>3</li>
            </forceEyesVisibleForRotations>
        </apparel>
        <tradeTags>
            <li>Armor</li>
        </tradeTags>
        <recipeMaker>
            <displayPriority>110</displayPriority>
        </recipeMaker>
    </ThingDef>

    <!-- ====================================== 高级头盔 =========================================== -->

