    <ThingDef ParentName="Mugirl_OnSkinBase">
        <defName>Mugirl_ImmortalFairy</defName>
        <!-- 雪牛娘 仙女服装 -->
        <label>Mugirl Fairy Raiment</label>
        <!-- 云烟缭绕的轻纱羽衣，衣背裁作流瀑般敞开，绛色绸带随步伐微浮。袖口绣有星辰金线，步时如碎光飞落。腰间一抹冰丝流苏衬出纤柔柳腰，胸前曲线若清光勾勒，若隐若现，宛如仙气凝成的弧度。华美非为炫耀，而是修仙者玄力外放的自然流转，美韵本就是最锋利的法器。 -->
        <description>An ethereal robe of drifting gauze, its back falling open like a cascading waterfall while crimson ribbons rise and settle with each step. Golden threads of starlight glimmer along the sleeves, and a frost-silk tassel at the waist traces a willow-slender figure. The curve of the chest appears and fades like moonlit mist, as though immortal grace itself had taken shape. Its splendour is not mere display, but the natural outward flow of cultivated power, with beauty itself serving as the keenest weapon.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_ImmortalFairy/Mugirl_ImmortalFairy</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <costStuffCount>50</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <SocialImpact>0.35</SocialImpact> <!-- 强化仙女气质，提高社交效果 -->
            <PsychicSensitivity>0.15</PsychicSensitivity> <!-- 修仙系增加微弱灵感 -->
        </equippedStatOffsets>
        <statBases>
            <MaxHitPoints>140</MaxHitPoints> <!-- 轻型但耐用 -->
            <WorkToMake>7500</WorkToMake> <!-- 仙衣工艺复杂，制作时间稍高 -->
            <Mass>0.6</Mass> <!-- 羽衣应非常轻盈 -->
            <ArmorRating_Sharp>0.08</ArmorRating_Sharp> <!-- 轻度防护 -->
            <ArmorRating_Blunt>0.02</ArmorRating_Blunt>
            <ArmorRating_Heat>0.10</ArmorRating_Heat> <!-- 轻度灵力护体效果 -->
            <StuffEffectMultiplierArmor>0.18</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold> <!--修仙服常给轻薄暖意 -->
            <StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
        </statBases>
        <apparel>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <useWornGraphicMask>false</useWornGraphicMask>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_ImmortalFairy/Mugirl_ImmortalFairy</wornGraphicPath>
        </apparel>
    </ThingDef>

