    <ThingDef ParentName="Mugirl_OnSkinBase">
        <defName>Mugirl_Uniform</defName>
        <!-- 雪牛娘 制式服装 「权力禁区」 -->
        <label>Mugirl Uniform "Zone Interdite du Pouvoir"</label>
        <!-- 雪牛娘标准制服，收腰西装搭配超短裙尽显窈窕身材，膝上十公分剪裁彰显绝对领域。办公室里的致命武器，每一步都踏在规则与欲望的边界线上，唤醒禁忌幻想。 -->
        <description>The standard Mugirl uniform: a tailored blazer paired with an ultra-short skirt that accentuates a slender figure.\nThe ten-centimetre-above-knee cut highlights the absolute territory.\nA lethal weapon in the office environment, each step treads the line between propriety and desire, awakening forbidden fantasies.</description>
        <graphicData>
            <texPath>Things/Apparel/Mugirl_Uniform/Mugirl_Uniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <costStuffCount>70</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToMake>16000</WorkToMake>
            <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.10</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.10</ArmorRating_Heat>
        </statBases>
        <equippedStatOffsets>
            <SocialImpact>0.1</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <useWornGraphicMask>false</useWornGraphicMask>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Mugirl_Uniform/Mugirl_Uniform</wornGraphicPath>
        </apparel>
    </ThingDef>

