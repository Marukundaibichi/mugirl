<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Mugirl_NormanLance</defName>
    <label>Norman lance</label>
    <description>A balanced cavalry lance patterned after an old Norman design. Its straightforward construction makes repeated line charges practical.</description>
    <graphicData><texPath>Things/Item/Equipment/MugirlWeapon/Mugirl_NormanLance</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>CutoutComplex</shaderType><drawSize>1.35</drawSize></graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags><li>MedievalMeleeAdvanced</li><li>Spear</li></weaponTags>
    <weaponClasses><li>MeleePiercer</li></weaponClasses>
    <costStuffCount>75</costStuffCount>
    <statBases><WorkToMake>12000</WorkToMake><Mass>2</Mass></statBases>
    <equippedAngleOffset>-25</equippedAngleOffset>
    <stuffCategories><li>Metallic</li><li>Woody</li></stuffCategories>
    <tools Inherit="False"><li><label>point</label><capacities><li>Stab</li></capacities><power>23</power><armorPenetration>0.50</armorPenetration><cooldownTime>2.6</cooldownTime></li></tools>
    <comps><li Class="Mugirl.Features.Lances.CompProperties_LanceCharge"><hasPointCharge>false</hasPointCharge><hasLineCharge>true</hasLineCharge><minimumLineRange>7</minimumLineRange><maximumRange>19.9</maximumRange><lineCooldownTicks>360</lineCooldownTicks><lineStunTicks>180</lineStunTicks><lineIconPath>UI/Commands/Lances/Mugirl_NormanLance_Line</lineIconPath></li></comps>
    <recipeMaker><researchPrerequisite>Mugirl_PneumaticWeapons</researchPrerequisite><skillRequirements><Crafting>5</Crafting></skillRequirements><displayPriority>331</displayPriority></recipeMaker>
  </ThingDef>

