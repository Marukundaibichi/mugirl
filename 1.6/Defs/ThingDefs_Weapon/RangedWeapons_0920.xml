    <verbs><li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>Bullet_Mugirl_AT23</defaultProjectile><warmupTime>2.4</warmupTime><range>38.9</range><burstShotCount>10</burstShotCount><ticksBetweenBurstShots>4</ticksBetweenBurstShots><soundCast>Shot_Autocannon</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>20</muzzleFlashScale></li></verbs>
