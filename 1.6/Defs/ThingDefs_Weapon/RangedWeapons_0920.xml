    <weaponTags><li>MugirlTech</li></weaponTags><weaponClasses><li>RangedHeavy</li></weaponClasses><tradeTags><li>WeaponRanged</li></tradeTags>
    <modExtensions><li Class="Mugirl.MugirlRaceRestrictedExtension"/></modExtensions>
  </ThingDef>
</Defs>
