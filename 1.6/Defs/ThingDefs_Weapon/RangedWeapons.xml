<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 雪牛娘支援突击步枪弹药（复用 MooGirl_Assault_Rifle） -->
    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_MooGirl_AR_Standard</defName>
        <!-- 雪牛娘突击步枪弹 -->
        <label>MooGirl assault round</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>21</damageAmountBase>
            <stoppingPower>1.2</stoppingPower>
            <speed>85</speed>
            <armorPenetrationBase>0.60</armorPenetrationBase>
        </projectile>
    </ThingDef>

    <!-- 雪牛娘支援突击步枪 -->
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>MuGirl_Gun_Support_Assault_Rifle</defName>
        <!-- 雪牛娘支援突击步枪 -->
        <label>Mugirl Support Assault Rifle</label>
        <!-- 雪牛娘使用的大火力步枪，尽管只是普通的火药步枪，但基于雪牛娘那强大的体格进行设计，这把枪拥有着远强于普通轻机枪的火力 -->
        <description>A heavy-firepower rifle used by Mugirls. Although it is only an ordinary gunpowder rifle, it is designed around the powerful Mugirl physique and has firepower far beyond a standard light machine gun.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/MuGirlWeapon/Support_Assault_Rifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>2.2</drawSize>
        </graphicData>
        <techLevel>Industrial</techLevel>
        <soundInteract>Interact_Rifle</soundInteract>
        <statBases>
            <WorkToMake>60000</WorkToMake>
            <Mass>12</Mass>
            <AccuracyTouch>0.62</AccuracyTouch>
            <AccuracyShort>0.67</AccuracyShort>
            <AccuracyMedium>0.64</AccuracyMedium>
            <AccuracyLong>0.58</AccuracyLong>
            <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>120</Steel>
            <ComponentIndustrial>14</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <recipeUsers>
                <li>TableMachining</li>
            </recipeUsers>
            <researchPrerequisite>PrecisionRifling</researchPrerequisite>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_MooGirl_AR_Standard</defaultProjectile>
                <warmupTime>0.8</warmupTime>
                <range>32.92</range>
                <burstShotCount>5</burstShotCount>
                <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
                <soundCast>Shot_ChargeRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>15</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <!-- 枪托 -->
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <!-- 枪管 -->
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <weaponTags>
            <li>MooGirlTech</li>
        </weaponTags>
    </ThingDef>

    <!-- 雪牛娘冲锋手枪弹药（复用 MooGirl_Machine_Pistol） -->
    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_MooGirl_MP_Standard</defName>
        <!-- 雪牛娘手枪弹 -->
        <label>MooGirl pistol round</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>13</damageAmountBase>
            <stoppingPower>0.8</stoppingPower>
            <speed>65</speed>
            <armorPenetrationBase>0.45</armorPenetrationBase>
        </projectile>
    </ThingDef>

    <!-- 雪牛娘冲锋手枪 -->
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>MuGirl_Gun_Machine_Pistol</defName>
        <!-- 雪牛娘冲锋手枪 -->
        <label>Mugirl Machine Pistol</label>
        <!-- 雪牛娘使用的基础手枪，尽管用的只是普通的火药，但基于雪牛娘那强大的体格进行设计，这把枪拥有着远强于普通自动手枪的火力 -->
        <description>A basic pistol used by Mugirls. Although it uses ordinary gunpowder, it is designed around the powerful Mugirl physique and has firepower far beyond a standard autopistol.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/MuGirlWeapon/Machine_Pistol</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>2.5</drawSize>
        </graphicData>
        <techLevel>Industrial</techLevel>
        <soundInteract>Interact_Autopistol</soundInteract>
        <statBases>
            <WorkToMake>16500</WorkToMake>
            <Mass>4.0</Mass>
            <AccuracyTouch>0.68</AccuracyTouch>
            <AccuracyShort>0.66</AccuracyShort>
            <AccuracyMedium>0.50</AccuracyMedium>
            <AccuracyLong>0.22</AccuracyLong>
            <RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>90</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <recipeUsers>
                <li>TableMachining</li>
            </recipeUsers>
            <researchPrerequisite>BlowbackOperation</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_MooGirl_MP_Standard</defaultProjectile>
                <warmupTime>0.4</warmupTime>
                <range>24.88</range>
                <burstShotCount>3</burstShotCount>
                <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
                <soundCast>Shot_MachinePistol</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <!-- 握把 -->
                <label>grip</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.6</cooldownTime>
            </li>
            <li>
                <!-- 枪管 -->
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.6</cooldownTime>
            </li>
        </tools>
        <weaponTags>
            <li>MooGirlTech</li>
        </weaponTags>
    </ThingDef>

    <!-- 雪牛娘防卫步枪弹药（复用 MooGirl_Militia_Rifle） -->
    <ThingDef ParentName="BaseBullet">
        <defName>Bullet_MooGirl_Militia_Rifle</defName>
        <!-- 民兵步枪弹 -->
        <label>militia rifle cartridge</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Big</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>24</damageAmountBase>
            <stoppingPower>3.0</stoppingPower>
            <speed>90</speed>
            <armorPenetrationBase>1.40</armorPenetrationBase>
        </projectile>
    </ThingDef>

    <!-- 雪牛娘防卫步枪 -->
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>MuGirl_Gun_Defense_Rifle</defName>
        <!-- 雪牛娘防卫步枪 -->
        <label>Mugirl Defense Rifle</label>
        <!-- 雪牛娘使用的长射程步枪，尽管只是普通的火药步枪，但基于雪牛娘那强大的体格进行设计，这把枪拥有着强于普通步枪的性能 -->
        <description>A long-range rifle used by Mugirls. Although it is only an ordinary gunpowder rifle, it is designed around the powerful Mugirl physique and performs better than a standard rifle.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/MuGirlWeapon/Defense_Rifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>2.2</drawSize>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <statBases>
            <WorkToMake>18000</WorkToMake>
            <Mass>10.0</Mass>
            <AccuracyTouch>0.58</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.72</AccuracyMedium>
            <AccuracyLong>0.67</AccuracyLong>
            <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>120</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
        </costList>
        <recipeMaker>
            <researchPrerequisite>BlowbackOperation</researchPrerequisite>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_MooGirl_Militia_Rifle</defaultProjectile>
                <warmupTime>1.3</warmupTime>
                <range>48.83</range>
                <burstShotCount>2</burstShotCount>
                <ticksBetweenBurstShots>14</ticksBetweenBurstShots>
                <soundCast>Shot_AssaultRifle</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>15</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <!-- 刺刀 -->
                <label>bayonet</label>
                <capacities>
                    <li>Stab</li>
                </capacities>
                <power>12</power>
                <cooldownTime>1.2</cooldownTime>
                <armorPenetration>0.9</armorPenetration>
            </li>
        </tools>
        <weaponTags>
            <li>MooGirlTech</li>
        </weaponTags>
    </ThingDef>

    <!-- 雪牛娘火焰喷射器（复用原版迷你火焰冲击枪） -->
    <ThingDef ParentName="LightMechanoidGunRanged" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>MuGirl_Gun_Flame_Thrower</defName>
        <!-- 雪牛娘火焰喷射器 -->
        <label>Mugirl Flame Thrower</label>
        <!-- 这个武器先复用原版迷你火焰冲击枪的代码，后续修改。 -->
        <description>This weapon currently reuses the base game mini flamethrower code and will be revised later.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/MuGirlWeapon/Flame_Thrower</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>3.0</drawSize>
        </graphicData>
        <statBases>
            <MarketValue>1000</MarketValue>
            <Mass>15.8</Mass>
            <AccuracyTouch>0.55</AccuracyTouch>
            <AccuracyShort>0.67</AccuracyShort>
            <AccuracyMedium>0.45</AccuracyMedium>
            <AccuracyLong>0.30</AccuracyLong>
            <RangedWeapon_Cooldown>5.5</RangedWeapon_Cooldown>
            <WorkToMake>30000</WorkToMake>
        </statBases>
        <costList>
            <Steel>300</Steel>
            <ComponentIndustrial>10</ComponentIndustrial>
        </costList>
        <weaponTags>
            <li>MechanoidGunMiniFlameblaster</li>
        </weaponTags>
        <verbs>
            <li>
                <verbClass>Verb_SpewFire</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <warmupTime>0</warmupTime>
                <range>9.95</range>
                <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
                <burstShotCount>12</burstShotCount>
                <soundCast>Shot_MiniFlameblaster</soundCast>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
    </ThingDef>


</Defs>
