<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <QuestScriptDef>
        <defName>Mugirl_SlaveOpeningPodCrash</defName>
        <autoAccept>true</autoAccept>
        <defaultCharity>true</defaultCharity>
        <successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityFulfilled_RefugeePodCrash</successHistoryEvent>
        <failedOrExpiredHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityRefused_RefugeePodCrash</failedOrExpiredHistoryEvent>
        <defaultHidden>true</defaultHidden>
        <isRootSpecial>true</isRootSpecial>
        <questNameRules>
            <rulesStrings>
                <!-- questName->逃生舱坠毁（雪牛娘奴隶） -->
                <li>questName->Transport pod crash</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <!-- questDescription->一名雪牛娘奴隶的太空逃生舱在你殖民地附近坠毁。她刚刚从巨型企业的奴隶运输船中逃脱，究竟是飞船故障、遭遇攻击，还是她以其他方式逃脱尚不得而知。\n\n逃亡经历令她精疲力尽，身上的紧实的奴隶束具，默默诉说着她在企业暴政下遭受的苦难。\n\n如今她无处可去，如果你选择营救她，她可能会加入你的殖民地，你愿意给这位可爱又可怜的逃亡者一次自由与新生活的机会吗？ -->
                <li>questDescription->A transport pod crashes with a refugee</li>
            </rulesStrings>
        </questDescriptionRules>
        <everAcceptableInSpace>true</everAcceptableInSpace> <!-- 由 quest part 自行处理可接受性。 -->
        <root Class="Mugirl.QuestNode_Root_Mugirl_OpeningPodCrash" />
    </QuestScriptDef>

    <QuestScriptDef>
        <defName>Mugirl_SlaveRefugeePodCrash</defName>
        <autoAccept>true</autoAccept>
        <defaultCharity>true</defaultCharity>
        <successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityFulfilled_RefugeePodCrash</successHistoryEvent>
        <failedOrExpiredHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityRefused_RefugeePodCrash</failedOrExpiredHistoryEvent>
        <defaultHidden>true</defaultHidden>
        <isRootSpecial>true</isRootSpecial>
        <questNameRules>
            <rulesStrings>
                <!-- questName->逃生舱坠毁（雪牛娘奴隶） -->
                <li>questName->Transport pod crash</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <!-- questDescription->一名雪牛娘奴隶的太空逃生舱在你殖民地附近坠毁。她刚刚从巨型企业的奴隶运输船中逃脱，究竟是飞船故障、遭遇攻击，还是她以其他方式逃脱尚不得而知。\n\n紧密捆缚在身上的奴隶束具，无声记录着她在巨型企业暴政下的痛苦与屈从。\n\n如今她无处可去，如果你选择营救她，她可能会加入你的殖民地。 -->
                <li>questDescription->A transport pod crashes with a refugee</li>
            </rulesStrings>
        </questDescriptionRules>
        <everAcceptableInSpace>true</everAcceptableInSpace> <!-- 由 quest part 自行处理可接受性。 -->
        <root Class="Mugirl.QuestNode_Root_Mugirl_RefugeePodCrash" />
    </QuestScriptDef>

    <QuestScriptDef>
        <defName>Mugirl_SlaveWandererJoins</defName>
        <autoAccept>true</autoAccept>
        <defaultHidden>true</defaultHidden>
        <isRootSpecial>true</isRootSpecial>
        <successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityFulfilled_WandererJoins</successHistoryEvent>
        <failedOrExpiredHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityRefused_WandererJoins</failedOrExpiredHistoryEvent>
        <questNameRules>
            <rulesStrings>
                <!-- questName->流浪雪牛娘奴隶加入 -->
                <li>questName->Wanderer joins</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <!-- questDescription->从奴隶商队逃脱的雪牛娘流浪到这里，破旧束具仍缠绕身上，诉说着她被奴隶的悲惨经历。你可以尝试救助并驯服她。 -->
                <li>questDescription-></li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="Mugirl.QuestNode_Root_Mugirl_WandererJoin_WalkIn" />
    </QuestScriptDef>

</Defs>
