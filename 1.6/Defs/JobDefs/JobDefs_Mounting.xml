<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <JobDef>
        <defName>Job_MountMugirl</defName>
        <driverClass>Mugirl.JobDriver_MountMugirl</driverClass>
        <reportString>mounting TargetA.</reportString> <!-- 骑上 TargetA。 -->
        <suspendable>false</suspendable>
    </JobDef>

    <JobDef>
        <defName>Job_DismountMugirl</defName>
