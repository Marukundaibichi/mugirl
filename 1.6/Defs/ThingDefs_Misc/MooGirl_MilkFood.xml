<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- 奶制食物不继承 MealBase 的食物中毒组件。 -->
    <ThingDef Name="MooGirl_MilkFoodBase" ParentName="MealBase" Abstract="True">
        <tradeability>Sellable</tradeability>
        <statBases>
            <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
        </statBases>
        <comps Inherit="False">
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Ingredients">
                <splitTransferableFoodKind>true</splitTransferableFoodKind>
            </li>
            <li MayRequire="Ludeon.RimWorld.Anomaly" Class="CompProperties_MetalhorrorInfectible" />
        </comps>
    </ThingDef>

    <!-- ============== 雪牛娘奶布丁 ============== -->
    <ThingDef ParentName="MooGirl_MilkFoodBase">
        <defName>MooGirl_MilkPudding</defName>
        <!-- 雪牛娘奶布丁 -->
        <label>Mugirl milk pudding</label>
        <!-- 口感像更柔软的果冻，香浓而又入口即化，吃上一份就能让孩子们回味上好几天，很多大人也非常爱吃 -->
        <description>Soft like a delicate jelly, rich and quick to melt in the mouth. One serving can linger in a child's memory for days, and many adults love it too.</description>
        <graphicData>
            <texPath>Things/milkfood/milkfood_pudding</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <MarketValue>10</MarketValue>
            <Nutrition>1.3</Nutrition>
            <Flammability>1.0</Flammability>
            <Mass>0.04</Mass>
            <DeteriorationRate>1.0</DeteriorationRate>
        </statBases>
        <ingestible>
            <preferability>MealFine</preferability>
            <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
            <tasteThought>Consumed_MooGirlPudding</tasteThought>
            <specialThoughtAsIngredient>Consumed_MooGirlPudding</specialThoughtAsIngredient>
        </ingestible>
        <tradeTags>
            <li>MooGirl_MilkFood</li>
        </tradeTags>
    </ThingDef>

    <!-- ============== 雪牛娘奶酪 ============== -->
    <ThingDef ParentName="MooGirl_MilkFoodBase">
        <defName>MooGirl_Cheese</defName>
        <!-- 雪牛娘奶酪 -->
        <label>Mugirl cheese</label>
        <!-- 很经典的食物，同时保存期极长而且管饱，是高级干肉饼 -->
        <description>A classic food with a very long shelf life and enough nutrition to fill you up, like an upgraded survival meal.</description>
        <graphicData>
            <texPath>Things/milkfood/milkfood_cheese</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <MarketValue>10</MarketValue>
            <Nutrition>1.5</Nutrition>
            <Flammability>1.0</Flammability>
            <Mass>0.04</Mass>
            <DeteriorationRate>1.0</DeteriorationRate>
        </statBases>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>10000</daysToRotStart>
                <rotDestroys>false</rotDestroys>
            </li>
        </comps>
        <ingestible>
            <preferability>MealFine</preferability>
            <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
            <tasteThought>Consumed_MooGirlCheese</tasteThought>
            <specialThoughtAsIngredient>Consumed_MooGirlCheese</specialThoughtAsIngredient>
            <outcomeDoers>
                <li Class="MooGirl.IngestionOutcomeDoer_RemoveHediffs">
                    <removeHediffs>
                        <li>FoodPoisoning</li>
                        <li>ToxicBuildup</li>
                    </removeHediffs>
                </li>
            </outcomeDoers>
        </ingestible>
        <tradeTags>
            <li>MooGirl_MilkFood</li>
        </tradeTags>
    </ThingDef>

    <!-- ============== 雪牛娘陈年奶酪 ============== -->
    <ThingDef ParentName="MooGirl_MilkFoodBase">
        <defName>MooGirl_AgedCheese</defName>
        <!-- 雪牛娘陈年奶酪 -->
        <label>Aged Mugirl cheese</label>
        <!-- 精品制作的奶酪，使用了比普通奶酪更长的发酵时间，充分发酵过后微生物与雪牛娘奶和啤酒花的混合成分发生了复杂的化学反应，产生出一种神奇的氨基酸，这种氨基酸能使体内肝脏等器官活性大幅提高，是心脑血管疾病患者的必备食品。请记得多为家中有遗传病史的长辈准备，尤其是爷爷奶奶之类的老人，加热融化后的陈年奶酪蕴含的糖含量低，脂肪易消化和分解——源自食品检验检测部门的认证 -->
        <description>A fine cheese made with longer fermentation than ordinary cheese. After full fermentation, microorganisms react with Mugirl milk and hops to produce a special amino acid that greatly improves the activity of the liver and other organs, making it a staple for people worried about cardiovascular illness.\n\nRemember to prepare more for elders with family medical histories, especially grandparents. Melted aged cheese is low in sugar, easy to digest, and easy to break down, according to food inspection certification.</description>
        <graphicData>
            <texPath>Things/milkfood/milkfood_Agedcheese</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <MarketValue>10</MarketValue>
            <Nutrition>2</Nutrition>
            <Flammability>1.0</Flammability>
            <Mass>0.24</Mass>
            <DeteriorationRate>1.0</DeteriorationRate>
        </statBases>
        <ingestible>
            <preferability>MealFine</preferability>
            <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
            <tasteThought>Consumed_MooGirlAgedCheese</tasteThought>
            <specialThoughtAsIngredient>Consumed_MooGirlAgedCheese</specialThoughtAsIngredient>
            <outcomeDoers>
                <li Class="MooGirl.IngestionOutcomeDoer_AddOrRefreshHediff">
                    <hediffDef>Hediff_MooGirlAgedCheese</hediffDef>
                    <severity>1.0</severity>
                </li>
            </outcomeDoers>
        </ingestible>
        <tradeTags>
            <li>MooGirl_MilkFood</li>
        </tradeTags>
    </ThingDef>

