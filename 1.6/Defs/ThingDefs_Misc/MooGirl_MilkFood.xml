<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 奶制食物不继承 MealBase 的食物中毒组件。 -->
  <ThingDef Name="MooGirl_MilkFoodBase" ParentName="MealBase" Abstract="True">
    <tradeability>Sellable</tradeability>
    <statBases>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Ingredients">
        <splitTransferableFoodKind>true</splitTransferableFoodKind>
      </li>
      <li MayRequire="Ludeon.RimWorld.Anomaly" Class="CompProperties_MetalhorrorInfectible" />
    </comps>
  </ThingDef>

  <!-- ============== 雪牛娘奶布丁 ============== -->
  <ThingDef ParentName="MooGirl_MilkFoodBase">
    <defName>MooGirl_MilkPudding</defName>
    <label>MooGirl_MilkPudding.label</label>
    <description>MooGirl_MilkPudding.description</description>
    <graphicData>
      <texPath>Things/milkfood/milkfood_pudding</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>10</MarketValue>
      <Nutrition>1.3</Nutrition>
      <Flammability>1.0</Flammability>
      <Mass>0.04</Mass>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
      <tasteThought>Consumed_MooGirlPudding</tasteThought>
      <specialThoughtAsIngredient>Consumed_MooGirlPudding</specialThoughtAsIngredient>
    </ingestible>
    <tradeTags>
      <li>MooGirl_MilkFood</li>
    </tradeTags>
  </ThingDef>

  <!-- ============== 雪牛娘奶酪 ============== -->
  <ThingDef ParentName="MooGirl_MilkFoodBase">
    <defName>MooGirl_Cheese</defName>
    <label>MooGirl_Cheese.label</label>
    <description>MooGirl_Cheese.description</description>
    <graphicData>
      <texPath>Things/milkfood/milkfood_cheese</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>10</MarketValue>
      <Nutrition>1.5</Nutrition>
      <Flammability>1.0</Flammability>
      <Mass>0.04</Mass>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>10000</daysToRotStart>
        <rotDestroys>false</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
      <tasteThought>Consumed_MooGirlCheese</tasteThought>
      <specialThoughtAsIngredient>Consumed_MooGirlCheese</specialThoughtAsIngredient>
      <outcomeDoers>
        <li Class="MooGirl.IngestionOutcomeDoer_RemoveHediffs">
          <removeHediffs>
            <li>FoodPoisoning</li>
            <li>ToxicBuildup</li>
          </removeHediffs>
        </li>
      </outcomeDoers>
    </ingestible>
    <tradeTags>
      <li>MooGirl_MilkFood</li>
    </tradeTags>
  </ThingDef>

