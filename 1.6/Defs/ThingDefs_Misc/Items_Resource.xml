<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="OrganicProductBase">
        <defName>MooGirl_Milk</defName>
        <!-- 雪牛奶 -->
        <label>Mugirl Milk</label>
        <!-- 雪牛娘分泌的乳汁，香甜浓郁，呈乳白带淡蓝色光泽。奇迹星基因工程让其营养成分远超普通牛奶，添加到食物中可以大幅提升免疫力，并促进伤口快速愈合。 -->
        <description>The milk secreted by Mugirls is sweet and rich, with a milky white hue and a light blue sheen. Miracle Star Genetic Engineering has endowed it with nutritional content far surpassing ordinary milk. When added to meals, it significantly boosts immunity and promotes rapid wound healing.</description>
        <graphicData>
            <texPath>Things/Item/Resource/MooGirl_Milk</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <tradeability>Sellable</tradeability>
        <tradeTags>
            <li>MooGirl_MilkFood</li>
        </tradeTags>
        <socialPropernessMatters>true</socialPropernessMatters>
        <statBases>
            <MarketValue>8</MarketValue>
            <Mass>0.045</Mass>
            <MaxHitPoints>60</MaxHitPoints>
            <Nutrition>0.1</Nutrition>
            <DeteriorationRate>10.0</DeteriorationRate>
            <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
        </statBases>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>14</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
        </comps>
        <ingestible>
            <preferability>RawTasty</preferability>
            <foodType>AnimalProduct, Fluid</foodType>
            <joy>0.25</joy>
            <maxNumToIngestAtOnce>10</maxNumToIngestAtOnce>
            <joyKind>Gluttonous</joyKind>
            <tasteThought>Consumed_MooGirlMilk</tasteThought>
            <babiesCanIngest>true</babiesCanIngest>
            <specialThoughtAsIngredient>Consumed_MooGirlMilk</specialThoughtAsIngredient>
        </ingestible>
        <thingCategories>
            <li>AnimalProductRaw</li>
        </thingCategories>
        <allowedArchonexusCount>80</allowedArchonexusCount>
    </ThingDef>

    <ThoughtDef>
        <thoughtClass>MooGirl.Thought_Hediff</thoughtClass>
        <defName>Consumed_MooGirlMilk</defName>
        <hediff>Consumed_MooGirlMilk</hediff>
        <durationDays>1</durationDays>
        <stages>
            <li>
                <!-- 喝了雪牛娘的奶 -->
                <label>Drank Mugirl's Milk</label>
                <!-- 真好喝! -->
                <description>So delicious!</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <HediffDef>
        <defName>Consumed_MooGirlMilk</defName>
        <!-- 强身健体！ -->
        <label>Fitter and Stronger!</label>
        <makesSickThought>false</makesSickThought>
        <!-- 雪牛娘的奶富含修复因子，可以极大的提高伤口修复效率。 -->
        <description>Mugirl's milk is rich in restorative factors that can significantly improve wound healing efficiency.</description>
        <tendable>false</tendable>
        <isBad>false</isBad>
        <defaultLabelColor>(255,242,0)</defaultLabelColor>
        <hediffClass>HediffWithComps</hediffClass>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <comps>
            <li Class="MooGirl.HediffCompProperties_WhileHavingThoughts">
                <thoughtDefs>
                    <li>Consumed_MooGirlMilk</li>
                </thoughtDefs>
            </li>
        </comps>
        <stages>
            <li>
                <statFactors>
                    <ImmunityGainSpeed>1.75</ImmunityGainSpeed>
                    <InjuryHealingFactor>1.75</InjuryHealingFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>


    <ThingDef ParentName="WoolBase">
        <defName>MooGirl_Wool</defName>
        <!-- 雪牛娘毛 -->
        <label>Mugirl Fur</label>
        <!-- 奇迹星基因工程的副产物之一——雪牛娘的毛发，雪牛一样的淡蓝色，但在质感上远比雪牛毛更柔软。细细嗅闻能闻到淡淡的牛油味。 -->
        <description>A by-product of the Miracle Star Genetic Engineering programme- the fur of Mugirls, possessing the same light blue colour as Muffalo fur but significantly softer in texture. When sniffed closely, it carries a faint buttery scent.</description>
        <graphicData>
            <texPath>Things/Item/Resource/MooGirl_Wool</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <color>(183,212,222)</color>
        </graphicData>
        <statBases>
            <MarketValue>5.0</MarketValue>
            <StuffPower_Armor_Sharp>1</StuffPower_Armor_Sharp>
            <StuffPower_Armor_Blunt>0.8</StuffPower_Armor_Blunt>
            <StuffPower_Armor_Heat>1.6</StuffPower_Armor_Heat>
            <StuffPower_Insulation_Cold>56</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>24</StuffPower_Insulation_Heat>
        </statBases>
        <stuffProps>
            <color>(183,212,222)</color>
            <statOffsets>
                <Insulation_Cold>3</Insulation_Cold>
                <Insulation_Heat>3</Insulation_Heat>
            </statOffsets>
            <statFactors>
                <Flammability>0.4</Flammability>
                <MaxHitPoints>1.75</MaxHitPoints>
            </statFactors>
        </stuffProps>
    </ThingDef>
</Defs>
