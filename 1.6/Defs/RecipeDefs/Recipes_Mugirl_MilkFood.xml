<Defs>

    <!-- ============== 雪牛娘奶布丁配方 ============== -->
    <RecipeDef ParentName="CookMealBase">
        <defName>Mugirl_MakeMilkPudding</defName>
        <!-- 制作雪牛娘奶布丁 -->
        <label>make Mugirl milk pudding</label>
        <!-- 用雪牛娘奶和素食制作奶布丁 -->
        <description>Make milk pudding with Mugirl milk and vegetarian ingredients.</description>
        <!-- 正在制作雪牛娘奶布丁 -->
        <jobString>Making Mugirl milk pudding.</jobString>
        <workAmount>300</workAmount>
        <recipeUsers>
            <li>ElectricStove</li>
            <li>FueledStove</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Mugirl_Milk</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>
            <li>
                <filter>
                    <categories>
                        <li>PlantFoodRaw</li>
                    </categories>
                </filter>
                <count>0.1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Mugirl_Milk</li>
            </thingDefs>
            <categories>
                <li>PlantFoodRaw</li>
            </categories>
        </fixedIngredientFilter>
        <products>
            <Mugirl_MilkPudding>4</Mugirl_MilkPudding>
        </products>
    </RecipeDef>

