  <!-- ============== 雪牛娘奶布丁配方 ============== -->
  <RecipeDef ParentName="CookMealBase">
    <defName>MooGirl_MakeMilkPudding</defName>
    <label>MooGirl_MakeMilkPudding.label</label>
    <description>MooGirl_MakeMilkPudding.description</description>
    <jobString>MooGirl_MakeMilkPudding.jobString</jobString>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MooGirl_Milk</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MooGirl_Milk</li>
      </thingDefs>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MooGirl_MilkPudding>4</MooGirl_MilkPudding>
    </products>
  </RecipeDef>

