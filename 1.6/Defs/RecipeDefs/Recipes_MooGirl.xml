  <RecipeDef ParentName="Make_MooGirlKeys">
    <defName>MooGirl_MakeKey_Medieval</defName>
    <label>制作粗糙束具钥匙</label>
    <description>制作一把粗糙束具钥匙</description>
    <jobString>正在制作粗糙束具钥匙</jobString>
    <workAmount>1000</workAmount>
    <recipeUsers>
      <li>ElectricSmithy</li>
      <li>FueledSmithy</li>
      <li>TableMachining</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MooGirl_SlaveApperalKey_Medieval>1</MooGirl_SlaveApperalKey_Medieval>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
  </RecipeDef>

