        <description>Make a exquisite key to unlock high-level restraint.</description>
        <!-- 正在制作精致束具钥匙 -->
        <jobString>Making Dedicate Restraint Key</jobString>
        <workAmount>1500</workAmount>
        <recipeUsers>
            <li>TableMachining</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>100</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentIndustrial</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Steel</li>
                <li>ComponentIndustrial</li>
                <li>Silver</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <MooGirl_SlaveApperalKey_Industrial>1</MooGirl_SlaveApperalKey_Industrial>
        </products>
        <skillRequirements>
            <Crafting>8</Crafting>
        </skillRequirements>
    </RecipeDef>

