    <RecipeDef ParentName="Make_MooGirlKeys">
        <defName>MooGirl_MakeKey_Advance</defName>
        <!-- 制作束具破解器 -->
        <label>Make Restraint Decryptor</label>
        <!-- 制作一个束具破解器 -->
        <description>Make a restraint decryptor.</description>
        <!-- 正在制作束具破解器 -->
        <jobString>Making restraint decryptor</jobString>
        <workAmount>4000</workAmount>
        <recipeUsers>
            <li>FabricationBench</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Plasteel</li>
                    </thingDefs>
                </filter>
                <count>220</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentSpacer</li>
                    </thingDefs>
                </filter>
                <count>4</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Gold</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Plasteel</li>
                <li>ComponentSpacer</li>
                <li>Gold</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <MooGirl_SlaveApperalKey_Advance>1</MooGirl_SlaveApperalKey_Advance>
        </products>
        <skillRequirements>
            <Crafting>14</Crafting>
            <Intellectual>12</Intellectual>
        </skillRequirements>
    </RecipeDef>

    <RecipeDef>
        <defName>MooGirl_SmeltBondageApparel</defName>
        <!-- 熔炼束具 -->
        <label>Smelt restraint apparel</label>
        <!-- 利用高温和电磁铁将装甲之类的束具衣物分解成有用的资源。 -->
        <description>Use high heat and electromagnets to break armored restraint apparel down into useful resources.</description>
        <!-- 正在熔炼衣物。 -->
        <jobString>Smelting restraint apparel</jobString>
        <workAmount>1600</workAmount>
        <workSpeedStat>SmeltingSpeed</workSpeedStat>
        <effectWorking>Smelt</effectWorking>
        <soundWorking>Recipe_Smelt</soundWorking>
        <specialProducts>
            <li>Smelted</li>
        </specialProducts>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Apparel</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>MooGirl_Slave</li>
            </categories>
            <specialFiltersToDisallow>
                <li>AllowNonSmeltableApparel</li>
            </specialFiltersToDisallow>
        </fixedIngredientFilter>
        <forceHiddenSpecialFilters>
            <li>AllowSmeltableApparel</li>
            <li>AllowBurnableApparel</li>
            <li>AllowNonBurnableApparel</li>
        </forceHiddenSpecialFilters>
    </RecipeDef>

</Defs>