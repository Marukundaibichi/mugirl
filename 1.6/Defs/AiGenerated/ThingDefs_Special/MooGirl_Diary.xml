<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>MooGirl_CourierDiary</defName>
    <label>运货员日记本</label>
    <description>一个倒霉底层运货员的日记，其中凝结了他这么久以来摸爬滚打的经验</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <pathCost>15</pathCost>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <thingCategories>
      <li>Books</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Specialitems/diary/diary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>10</MarketValue>
      <Mass>0.20</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>3</Beauty>
      <DeteriorationRate>0.1</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="MooGirl.CompProperties_ReadableBook">
        <bookTitle>运货员日记本</bookTitle>
      </li>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

</Defs>
