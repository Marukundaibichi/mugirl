<Defs>

  <!-- ============== 雪牛娘奶布丁配方 ============== -->
  <RecipeDef ParentName="CookMealBase">
    <defName>MooGirl_MakeMilkPudding</defName>
    <label>制作雪牛娘奶布丁</label>
    <description>用雪牛娘奶和素食制作奶布丁</description>
    <jobString>正在制作雪牛娘奶布丁</jobString>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MooGirl_Milk</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MooGirl_Milk</li>
      </thingDefs>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MooGirl_MilkPudding>4</MooGirl_MilkPudding>
    </products>
  </RecipeDef>

