<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ============== 奶布丁心情 ============== -->
    <ThoughtDef>
        <defName>Consumed_MugirlPudding</defName>
        <durationDays>5</durationDays>
        <stages>
            <li>
                <!-- 美味布丁 -->
                <label>delicious pudding</label>
                <!-- 甜甜的，香浓又入口即化，好吃 -->
                <description>Sweet, rich, and melts in the mouth. Delicious.</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- ============== 奶酪心情 ============== -->
    <ThoughtDef>
        <defName>Consumed_MugirlCheese</defName>
        <durationDays>1</durationDays>
        <stages>
            <li>
                <!-- 新鲜奶酪 -->
                <label>fresh cheese</label>
                <!-- 有点嚼劲，在嘴里慢慢融化成香浓的液态时，那股奶香会温柔的包裹舌头 -->
                <description>Slightly chewy, melting into a rich liquid in the mouth as the milky fragrance gently coats the tongue.</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- ============== 陈年奶酪心情 ============== -->
    <ThoughtDef>
        <defName>Consumed_MugirlAgedCheese</defName>
        <durationDays>1</durationDays>
        <stages>
            <li>
                <!-- 陈年奶酪 -->
                <label>aged cheese</label>
                <!-- 入口时嚼起来比起新鲜奶酪更硬一点，在口中融化时能尝到那股醇厚香甜的味道缠在舌头上，甜而不腻 -->
                <description>Harder than fresh cheese at first bite, then melting into a mellow sweetness that clings to the tongue without becoming cloying.</description>
                <baseMoodEffect>6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- ============== 共用浓郁奶味心情 ============== -->
    <ThoughtDef>
        <defName>Consumed_MugirlRichMilkFlavor</defName>
        <durationDays>1</durationDays>
        <stages>
            <li>
                <!-- 浓郁奶味 -->
                <label>rich milk flavor</label>
                <!-- 雪牛娘奶那甜甜的浓郁奶味在口腔内回荡 -->
                <description>The sweet, rich flavor of Mugirl milk lingers through the mouth.</description>
                <baseMoodEffect>6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- ============== 奶糖心情 ============== -->
    <ThoughtDef>
        <defName>Consumed_MugirlMilkCandy</defName>
        <durationDays>1</durationDays>
        <stages>
            <li>
                <!-- 好吃哒奶糖 -->
                <label>tasty milk candy</label>
                <!-- 每嚼一下甜甜的奶味就会从齿尖流过，越嚼越甜 -->
                <description>Each chew sends sweet milk flavor across the teeth, growing sweeter and sweeter.</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>
