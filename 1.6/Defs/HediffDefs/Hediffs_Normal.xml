<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <HediffDef ParentName="DiseaseBase">
        <!-- 逃脱奴役后的短期虚弱 Hediff，用于开局或事件后的行动限制。 -->
        <defName>MooGirl_Abasia</defName>
        <!-- 精疲力尽 -->
        <label>Exhausted</label>
        <!-- 她似乎在巨型企业的奴役下经历了未知的折磨，虽然设法逃脱出来，但在接下来的几天里，身体疲惫至极，几乎无法动弹。 -->
        <description>She appears to have been subjected to unknown torments under the enslavement of a mega corporation. Though she managed to escape, her body remains utterly drained over the coming days, barely able to move.</description>
        <!-- 从巨型企业的奴役下逃脱后，她身体极度疲惫，几乎无法动弹。 -->
        <descriptionShort>After escaping from the mega corporation's enslavement, she is completely exhausted and can scarcely move.</descriptionShort>
        <hediffClass>HediffWithComps</hediffClass>
        <preventsCrawling>true</preventsCrawling>

        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>1.0</severityPerDay>
            </li>
            <li Class="HediffCompProperties_Disappears">
                <!-- 约 2 天后自然消失，并在界面显示剩余时间。 -->
                <disappearsAfterTicks>120000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>

        <stages>
            <!-- 前期几乎无法移动，后期转为较轻的移动惩罚。 -->
            <li>
                <!-- 死里逃生 -->
                <label>Exhausted</label>
                <minSeverity>0.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0.1</setMax>
                    </li>
                </capMods>
                <statOffsets>
                    <ComfyTemperatureMin>-80</ComfyTemperatureMin>
                    <ComfyTemperatureMax>80</ComfyTemperatureMax>
                    <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
                </statOffsets>
            </li>
            <li>
                <!-- 应激恢复 -->
                <label>Exhausted</label>
                <minSeverity>1</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.2</offset>
                    </li>
                </capMods>
                <minSeverity>0.5</minSeverity>
                <statOffsets>
                    <ComfyTemperatureMin>-80</ComfyTemperatureMin>
                    <ComfyTemperatureMax>80</ComfyTemperatureMax>
                    <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>
</Defs>
