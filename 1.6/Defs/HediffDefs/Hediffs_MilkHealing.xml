<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 喝奶疗愈 Hediff（倒地喂奶时获得） -->
  <HediffDef>
    <defName>MooGirl_MilkHealing</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>雪牛奶疗愈</label>
    <description>雪牛娘的乳汁中含有特殊的愈合因子，正在加速伤势恢复、增强免疫并减轻疼痛。</description>
    <isBad>false</isBad>
    <defaultLabelColor>(255,192,203)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <ImmunityGainSpeed>1.5</ImmunityGainSpeed>
          <InjuryHealingFactor>2.0</InjuryHealingFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.2</offset>
          </li>
        </capMods>
        <painOffset>-0.3</painOffset>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
