	<HediffDef ParentName="MooGirl_BondageBase">
		<defName>MooGirl_MagneticShacklesBondage</defName>
		<label>磁力镣铐束缚</label>
		<labelNoun>磁力镣铐束缚</labelNoun>
		<description>雪牛娘的手臂被突然激活的磁力镣铐严格束缚在脖颈上，无法活动。</description>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Manipulation</capacity>
						<setMax>0.00</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

	<!-- ====================================== 电击项圈 =========================================== -->

	<HediffDef>
		<defName>MooGirl_EleShock</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>项圈电击</label>
		<description>不知道什么原因，电击项圈开始电击雪牛娘，还好只是轻微的电击。</description>
		<defaultLabelColor>(1, 0.752, 0.796)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<setMax>0.5</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>true</showRemainingTime>
				<disappearsAfterTicks>360</disappearsAfterTicks>
			</li>
			<!-- 电击 comp 实际具有周期循环功能 要恢复该功能只需要删除 ↑ 的 <li Class="HediffCompProperties_Disappears"> -->
			<li Class="MooGirl.CompProperties_EleShock">
				<effectCycleInterval>10</effectCycleInterval> <!-- 循环周期 -->
				<maxCycles>20</maxCycles> <!-- 最多几个循环 -->
				<stunDuration>7</stunDuration>
				<jitterMagnitude>0.2</jitterMagnitude>
				<shockSounds>
					<li>MooGirl_PowerEleShock_Sound</li>
				</shockSounds>
				<hediffsToApplyWithParams>
					<li>
						<hediff>Burn</hediff>
						<bodyPartTarget>Neck</bodyPartTarget>
						<severity>0.2</severity>
					</li>
				</hediffsToApplyWithParams>
				<!-- 生成污渍的 
				<filthSpawnEntries>
					<li>
						<filthDef>MooGirlMilkFilth</filthDef> 
						<filthAmount>1</filthAmount> 
						<spawnInterval>150</spawnInterval>  
						<spawnInFacingDirection>true</spawnInFacingDirection> 
					</li>
				</filthSpawnEntries>-->
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>MooGirl_PowerEleShock</defName>
