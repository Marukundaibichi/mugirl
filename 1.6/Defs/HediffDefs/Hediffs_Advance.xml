					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>true</showRemainingTime>
				<disappearsAfterTicks>360</disappearsAfterTicks>
			</li>
			<li Class="MooGirl.CompProperties_EleShock">
				<effectCycleInterval>10</effectCycleInterval>
				<maxCycles>20</maxCycles>
				<stunDuration>5</stunDuration>
				<jitterMagnitude>0.5</jitterMagnitude>
				<shockSounds>
					<li>MooGirl_PowerEleShock_Sound</li>
				</shockSounds>
				<hediffsToApplyWithParams>
					<li>
						<hediff>Burn</hediff>
						<bodyPartTarget>Neck</bodyPartTarget>
						<severity>0.6</severity>
					</li>
				</hediffsToApplyWithParams>
				<filthSpawnEntries>
					<li>
						<filthDef>MooGirlMilkFilth</filthDef> <!-- 生成污渍的 def 名称 -->
						<filthAmount>1</filthAmount> <!-- 生成的数量 -->
						<spawnInterval>100</spawnInterval>  <!-- 生成的周期 -->
						<spawnInFacingDirection>true</spawnInFacingDirection> <!-- 是否只在人物朝向方向生成 -->
					</li>
					<!-- 是否被强力电击后留下“神秘液体”，删除注释符后游戏内即可生成 -->
					<!--
					<li>
						<filthDef>MooGirlWaterFilth</filthDef>  
						<filthnumber>1</filthnumber> 
						<interval>200</interval> 
					</li>
					-->
				</filthSpawnEntries>
				<hediffsToRemove>
					<li>MooGirl_EleShock</li>
				</hediffsToRemove>
			</li>
		</comps>
	</HediffDef>

