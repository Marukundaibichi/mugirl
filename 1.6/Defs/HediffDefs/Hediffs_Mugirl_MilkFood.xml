<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ============== 陈年奶酪 Hediff：防感染、去毒素、解食物中毒，免疫速度 1.5 倍，毒素抗性 +0.15 ============== -->
    <HediffDef>
        <defName>Hediff_MugirlAgedCheese</defName>
        <!-- 陈年奶酪效果 -->
        <label>aged cheese effect</label>
        <!-- 陈年奶酪的特殊成分在体内发挥作用：防止伤口感染、提高血液过滤清除毒素、并加快免疫速度 -->
        <description>Special compounds from aged cheese are active in the body, preventing wound infection, improving blood filtration, clearing toxins, and speeding immunity.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <defaultLabelColor>(0,200,255)</defaultLabelColor>
        <tendable>false</tendable>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statFactors>
                    <ImmunityGainSpeed>1.5</ImmunityGainSpeed>
                </statFactors>
                <statOffsets>
                    <ToxicResistance>0.15</ToxicResistance>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>BloodFiltration</capacity>
                        <offset>0.25</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="Mugirl.HediffCompProperties_CureFoodEffects">
                <removeHediffs>
                    <li>FoodPoisoning</li>
                    <li>ToxicBuildup</li>
                    <li>WoundInfection</li>
                </removeHediffs>
            </li>
        </comps>
    </HediffDef>

    <!-- ============== 蛋糕 Hediff：饥饿速率降至 70% ============== -->
    <HediffDef>
        <defName>Hediff_MugirlCowCake</defName>
        <!-- 奶香蛋糕 -->
        <label>milky cake</label>
        <!-- 吃了块奶香浓郁的美味蛋糕 -->
        <description>Ate a delicious cake with a rich milk fragrance.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <defaultLabelColor>(255,192,128)</defaultLabelColor>
        <tendable>false</tendable>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <hungerRateFactor>0.7</hungerRateFactor>
            </li>
        </stages>
    </HediffDef>

