<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 哺乳期 Hediff -->
  <HediffDef>
    <defName>MooGirl_Lactation</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>哺乳期</label>
    <description>雪牛娘处于泌乳状态，可以哺育幼崽。乳汁分泌速度受营养状况影响。</description>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="MooGirl.CompProperties_Lactation">
        <baseProductionMultiplier>1.0</baseProductionMultiplier>
        <postpartumBoostDays>7</postpartumBoostDays>
        <postpartumMultiplier>2.5</postpartumMultiplier>
        <malnourishedPenalty>0.3</malnourishedPenalty>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>MooGirl_MotherlyNurture</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>雪牛娘妈妈的哺育</label>
    <description>这个孩子正在接受雪牛娘温柔而充足的哺育。进度越高，成长评级和学习能力加成越强。</description>
    <isBad>false</isBad>
    <defaultLabelColor>(255,192,203)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.001</initialSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>萌芽</label>
        <statFactors>
          <GlobalLearningFactor>1.5</GlobalLearningFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>充盈</label>
        <statFactors>
          <GlobalLearningFactor>2.0</GlobalLearningFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>圆满</label>
        <statFactors>
          <GlobalLearningFactor>2.5</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="MooGirl.HediffCompProperties_MooGirlNurtureProgress" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>MooGirl_NurtureAfterglow</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>雪牛娘哺育余韵</label>
    <description>雪牛娘长期哺育留下的成长余韵仍在这个孩子身上延续。</description>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <GlobalLearningFactor>2.5</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>27000000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
