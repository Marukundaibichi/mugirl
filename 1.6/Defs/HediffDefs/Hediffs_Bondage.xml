	<HediffDef ParentName="MooGirl_BondageBase">
		<defName>MooGirl_Armbinder</defName>
		<label>单手套束缚</label>
		<labelNoun>单手套束缚</labelNoun>
		<description>雪牛娘的手臂被束具严格束缚在身后，无法活动。</description>
		<renderNodeProperties>
			<li>
				<workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
				<bodyTypeGraphicPaths>
					<Female>Things/Apparel/MooGirl_SlaveApparel/MooGirl_Slavesarmbinder/Skin/MooGirl_Slavesarmbinder_Female</Female>
				</bodyTypeGraphicPaths>
				<baseLayer>49</baseLayer>
				<texSeed>1</texSeed>
				<useGraphic>true</useGraphic>
				<side>Center</side>
				<colorType>Skin</colorType>
				<rotDrawMode>Fresh,Rotting,Dessicated</rotDrawMode>
				<pawnType>HumanlikeOnly</pawnType>
				<linkedBodyPartsGroup>Waist</linkedBodyPartsGroup>
				<visibleFacing>
					<li>North</li>
					<li>South</li>
					<li>East</li>
					<li>West</li>
				</visibleFacing>
				<useSkinShader>true</useSkinShader>
			</li>
		</renderNodeProperties>		
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Manipulation</capacity>
						<setMax>0.00</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

