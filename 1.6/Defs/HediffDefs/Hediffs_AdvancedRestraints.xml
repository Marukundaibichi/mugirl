<Defs>

	<!-- ====================================== Magnetic shackles / 磁力镣铐 =========================================== -->

	<HediffDef ParentName="MooGirl_BondageBase">
		<defName>MooGirl_MagneticShacklesBondage</defName>
		<!-- 磁力镣铐束缚 -->
		<label>Magnetic Shackles Bondage</label>
		<!-- 磁力镣铐束缚 -->
		<labelNoun>Magnetic Shackles Bondage</labelNoun>
		<!-- 雪牛娘的手臂被突然激活的磁力镣铐严格束缚在脖颈上，无法活动。 -->
		<description>The Mugirl's arms were strictly restrained to the Mugirl's neck by the suddenly activated magnetic shackles, unable to move.</description>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Manipulation</capacity>
						<setMax>0.00</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

	<!-- ====================================== Shock collar / 电击项圈 =========================================== -->

	<HediffDef>
		<defName>MooGirl_EleShock</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<!-- 项圈电击 -->
		<label>Collar Electric Shock</label>
		<!-- 不知道什么原因，电击项圈开始电击雪牛娘，还好只是轻微的电击。 -->
		<description>For some reason, the electric shock collar started electrocuting the Mugirl, fortunately it was only a mild shock.</description>
		<defaultLabelColor>(1, 0.752, 0.796)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<setMax>0.5</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>true</showRemainingTime>
				<disappearsAfterTicks>360</disappearsAfterTicks>
			</li>
			<!-- Shock comp still supports cyclic effects; delete the Disappears comp above to restore looping. / 电击 comp 仍支持周期循环；删除上面的 Disappears comp 即可恢复循环。 -->
			<li Class="MooGirl.CompProperties_EleShock">
				<effectCycleInterval>10</effectCycleInterval> <!-- 循环周期 -->
				<maxCycles>20</maxCycles> <!-- 最多几个循环 -->
				<stunDuration>7</stunDuration>
				<jitterMagnitude>0.2</jitterMagnitude>
				<shockSounds>
					<li>MooGirl_PowerEleShock_Sound</li>
				</shockSounds>
				<hediffsToApplyWithParams>
					<li>
						<hediff>Burn</hediff>
						<bodyPartTarget>Neck</bodyPartTarget>
						<severity>0.2</severity>
					</li>
				</hediffsToApplyWithParams>
				<!-- Filth spawning, currently disabled. / 污渍生成，目前禁用。
				<filthSpawnEntries>
					<li>
						<filthDef>MooGirlMilkFilth</filthDef> 
						<filthAmount>1</filthAmount> 
						<spawnInterval>150</spawnInterval>  
						<spawnInFacingDirection>true</spawnInFacingDirection> 
					</li>
				</filthSpawnEntries>-->
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>MooGirl_PowerEleShock</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<!-- 强力项圈电击 -->
		<label>Powerful Collar Electric Shock</label>
		<!-- 不知道什么原因，电击项圈开始强烈的电击雪牛娘。快停下！真的会出牛命的呀... -->
		<description>For some reason, the electric shock collar started strongly electrocuting the Mugirl. Stop it quickly! It could really kill the Mugirl!</description>
		<defaultLabelColor>(1, 0.752, 0.796)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.2</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>true</showRemainingTime>
				<disappearsAfterTicks>360</disappearsAfterTicks>
			</li>
			<li Class="MooGirl.CompProperties_EleShock">
				<effectCycleInterval>10</effectCycleInterval>
				<maxCycles>20</maxCycles>
				<stunDuration>5</stunDuration>
				<jitterMagnitude>0.5</jitterMagnitude>
				<shockSounds>
					<li>MooGirl_PowerEleShock_Sound</li>
				</shockSounds>
				<hediffsToApplyWithParams>
					<li>
						<hediff>Burn</hediff>
						<bodyPartTarget>Neck</bodyPartTarget>
						<severity>0.6</severity>
					</li>
				</hediffsToApplyWithParams>
				<filthSpawnEntries>
					<li>
						<filthDef>MooGirlMilkFilth</filthDef> <!-- Filth def name / 污渍 Def 名称 -->
						<filthAmount>1</filthAmount> <!-- Spawn count / 生成数量 -->
						<spawnInterval>100</spawnInterval>  <!-- Spawn interval / 生成周期 -->
						<spawnInFacingDirection>true</spawnInFacingDirection> <!-- Spawn only in facing direction / 仅在人物朝向方向生成 -->
					</li>
					<!-- Optional mystery-fluid filth after powerful shock; uncomment to enable. / 强力电击后的可选“神秘液体”污渍；取消注释即可启用。 -->
					<!--
					<li>
						<filthDef>MooGirlWaterFilth</filthDef>  
						<filthnumber>1</filthnumber> 
						<interval>200</interval> 
					</li>
					-->
				</filthSpawnEntries>
				<hediffsToRemove>
					<li>MooGirl_EleShock</li>
				</hediffsToRemove>
			</li>
		</comps>
	</HediffDef>

