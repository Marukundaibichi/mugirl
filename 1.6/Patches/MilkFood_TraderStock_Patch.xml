<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- PatchGovernance:
    Targets: 原版和可选 DLC 的 TraderKindDef 库存生成器。
    Scope: 1.6 根经济补丁；通过商人出售雪牛娘奶制食物，不替换已有库存生成器。
    Duplicate guard: 每个库存生成器追加前都会检查 Mugirl_MilkFood 交易标签是否已经存在。
    Failure: 可选商人目标缺失时允许无操作；xpath 异常或必需目标漂移由 Phase 6 捕获。
    -->
    <!-- 派系基地库存。 -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/TraderKindDef[defName="Base_Neolithic_Standard"]/stockGenerators/li[@Class="StockGenerator_Tag"]/tradeTag[text()="Mugirl_MilkFood"]</xpath>
        <nomatch Class="PatchOperationConditional">
            <xpath>Defs/TraderKindDef[defName="Base_Neolithic_Standard"]/stockGenerators</xpath>
            <match Class="PatchOperationAdd">
                <xpath>Defs/TraderKindDef[defName="Base_Neolithic_Standard"]/stockGenerators</xpath>
                <value>
                    <li Class="StockGenerator_Tag">
                        <tradeTag>Mugirl_MilkFood</tradeTag>
                        <countRange>1~3</countRange>
                    </li>
                </value>
            </match>
        </nomatch>
    </Operation>

