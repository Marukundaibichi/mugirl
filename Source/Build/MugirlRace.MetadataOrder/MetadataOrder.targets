<Project>
  <PropertyGroup>
    <MugirlMetadataOrderProject>$(MSBuildThisFileDirectory)MugirlRace.MetadataOrder.csproj</MugirlMetadataOrderProject>
    <MugirlTypeOrderManifest>$(MSBuildProjectDirectory)/TypeOrder.txt</MugirlTypeOrderManifest>
  </PropertyGroup>
  <!-- 处理 obj 中间产物，随后普通复制输出与显式 Deploy 都取得同一最终 DLL/PDB。 -->
  <Target Name="MugirlOrderMetadata" AfterTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true'">
    <PropertyGroup>
      <_MugirlMetadataToolRoot>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), metadata-order-tool))</_MugirlMetadataToolRoot>
      <_MugirlMetadataToolDll>$(_MugirlMetadataToolRoot)bin/MugirlRace.MetadataOrder.dll</_MugirlMetadataToolDll>
      <_MugirlIntermediatePdb>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), $(TargetName).pdb))</_MugirlIntermediatePdb>
    </PropertyGroup>
    <Error Condition="!Exists('$(MugirlTypeOrderManifest)')" Text="TypeOrder.txt is required for the refactored build." />
    <!-- 清除父构建的输出重定向；本任务显式提供的三个路径不可放进 RemoveProperties。 -->
    <MSBuild Projects="$(MugirlMetadataOrderProject)" Targets="Restore;Build" BuildInParallel="false"
             RemoveProperties="ArtifactsPath;UseArtifactsOutput;ArtifactsProjectName;ArtifactsPivots;OutDir;BaseOutputPath;IntermediateOutputPath;IntermediateAssembly;PdbFile;DocumentationFile;TargetName;TargetFileName;TargetExt;TargetPath;TargetDir;MugirlDeployDir;TargetFramework;RuntimeIdentifier"
             Properties="Configuration=Release;DeployToMod=false;BaseIntermediateOutputPath=$(_MugirlMetadataToolRoot)obj/;MSBuildProjectExtensionsPath=$(_MugirlMetadataToolRoot)obj/;OutputPath=$(_MugirlMetadataToolRoot)bin/" />
    <RemoveDuplicates Inputs="@(ReferencePath->'%(RootDir)%(Directory)')">
      <Output TaskParameter="Filtered" ItemName="_MugirlMetadataReferenceDirectory" />
    </RemoveDuplicates>
    <Exec Command="dotnet &quot;$(_MugirlMetadataToolDll)&quot; --assembly &quot;@(IntermediateAssembly->'%(FullPath)')&quot; --pdb &quot;$(_MugirlIntermediatePdb)&quot; --order &quot;$(MugirlTypeOrderManifest)&quot; @(_MugirlMetadataReferenceDirectory->'--search-dir &quot;%(Identity).&quot;', ' ')" />
  </Target>
</Project>
