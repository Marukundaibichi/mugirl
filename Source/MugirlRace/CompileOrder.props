<Project>
  <!-- RenameApply compile order v1: 保持已有源码顺序；新增源码由项目默认 Compile 项自动追加，不必登记。 -->
  <Target Name="MugirlPreserveCompileOrder" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_MugirlOrderedCompile Remove="@(_MugirlOrderedCompile)" />
      <_MugirlRemainingCompile Remove="@(_MugirlRemainingCompile)" />
