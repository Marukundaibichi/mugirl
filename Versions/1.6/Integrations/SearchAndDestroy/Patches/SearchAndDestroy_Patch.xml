<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Search and Destroy think tree targets may change between versions. 目标缺失或已插入时静默跳过。 -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThinkTreeDef[defName="MooGirlLike"]//li[@Class="SearchAndDestroy.ThinkNode_ConditionalSearchAndDestroy"]</xpath>
        <nomatch Class="PatchOperationConditional">
            <xpath>Defs/ThinkTreeDef[defName="MooGirlLike"]/thinkRoot[@Class="ThinkNode_Priority"]/subNodes/li[@Class="ThinkNode_ConditionalColonist"][subNodes/li[@Class="ThinkNode_Tagger"]/tagToGive[text()="Idle"]]</xpath>
            <match Class="PatchOperationInsert">
                <!-- Insert before the unique idle colonist branch. 插入到唯一的殖民者闲置分支之前，避免命中多个殖民者节点。 -->
                <xpath>Defs/ThinkTreeDef[defName="MooGirlLike"]/thinkRoot[@Class="ThinkNode_Priority"]/subNodes/li[@Class="ThinkNode_ConditionalColonist"][subNodes/li[@Class="ThinkNode_Tagger"]/tagToGive[text()="Idle"]]</xpath>
                <value>
                    <!-- Do search and destroy instead of waiting. 执行主动搜索歼灭，而不是原地等待。 -->
                    <li Class="SearchAndDestroy.ThinkNode_ConditionalSearchAndDestroy">
                        <subNodes>
                            <li Class="ThinkNode_Priority">
                                <subNodes>
                                    <li Class="SearchAndDestroy.JobGiver_AIFightEnemiesShortExp">
                                        <targetAcquireRadius>200</targetAcquireRadius>
                                        <targetKeepRadius>72</targetKeepRadius>
                                    </li>
                                    <li Class="SearchAndDestroy.JobGiver_GoWithinRangeOfHostile"/>
                                </subNodes>
                            </li>
                        </subNodes>
                    </li>
                </value>
            </match>
        </nomatch>
    </Operation>
</Patch>
