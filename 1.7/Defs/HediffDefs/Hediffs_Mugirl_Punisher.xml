<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>Mugirl_PunisherKnockout</defName>
        <!-- 击昏 -->
        <label>knockout</label>
        <!-- 该单位遭受了重击，暂时失去意识。 -->
        <description>This unit has suffered a heavy blow and is temporarily unconscious.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~3000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.01</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>
