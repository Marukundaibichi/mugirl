<Defs>

    <HediffDef Name="Mugirl_BondageBase" Abstract="True">
        <hediffClass>Hediff</hediffClass>
        <defaultLabelColor>(0.5, 0.5, 0.9)</defaultLabelColor>
        <makesSickThought>false</makesSickThought>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <scenarioCanAdd>false</scenarioCanAdd>
    </HediffDef>

    <HediffDef ParentName="Mugirl_BondageBase">
        <defName>Mugirl_Armbinder</defName>
        <!-- 单手套束缚 -->
        <label>Arm Restraints</label>
        <!-- 单手套束缚 -->
        <labelNoun>Arm Restraints</labelNoun>
        <!-- 雪牛娘的手臂被束具严格束缚在身后，无法活动。 -->
        <description>The Mugirl's arms are strictly restrained behind her back by bondage gear, unable to move.</description>
        <renderNodeProperties>
            <li>
                <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
                <bodyTypeGraphicPaths>
                    <Female>Things/Apparel/Mugirl_SlaveApparel/Mugirl_Slavesarmbinder/Skin/Mugirl_Slavesarmbinder_Female</Female>
                </bodyTypeGraphicPaths>
                <baseLayer>49</baseLayer>
                <texSeed>1</texSeed>
                <useGraphic>true</useGraphic>
                <side>Center</side>
                <colorType>Skin</colorType>
                <rotDrawMode>Fresh,Rotting,Dessicated</rotDrawMode>
                <pawnType>HumanlikeOnly</pawnType>
                <linkedBodyPartsGroup>Waist</linkedBodyPartsGroup>
                <visibleFacing>
                    <li>North</li>
                    <li>South</li>
                    <li>East</li>
                    <li>West</li>
                </visibleFacing>
                <useSkinShader>true</useSkinShader>
            </li>
        </renderNodeProperties>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <setMax>0.00</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

