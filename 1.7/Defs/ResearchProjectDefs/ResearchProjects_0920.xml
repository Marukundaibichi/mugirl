<Defs>
    <ResearchProjectDef>
        <defName>Mugirl_PneumaticWeapons</defName>
        <label>Mugirl pneumatic lances</label>
        <description>Combine long-blade forging with refined chemfuel systems to build high-pressure steam lances.</description>
