        <prerequisites><li>LongBlades</li><li>BiofuelRefining</li><li>Mugirl_Firearms</li></prerequisites>
        <tab>Mugirl_ResearchTab</tab>
        <researchViewX>2.35</researchViewX><researchViewY>4.65</researchViewY>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>Mugirl_NeuralCombatSystems</defName>
        <label>Mugirl neural combat systems</label>
        <description>Recover the neural interfaces, deflection controls and fire-support systems of advanced Mugirl combat equipment.</description>
