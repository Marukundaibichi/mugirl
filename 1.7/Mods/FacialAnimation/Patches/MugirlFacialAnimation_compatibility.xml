                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="WaitCombat_Mugirl"]/targetJobs[not(li="RandomRape")]</xpath>
                    <match Class="PatchOperationAdd">
