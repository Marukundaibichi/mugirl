                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="ViolateCorpse")]</xpath>
