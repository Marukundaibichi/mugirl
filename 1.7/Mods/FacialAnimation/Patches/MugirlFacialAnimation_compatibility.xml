<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- PatchGovernance:
    Targets: 雪牛娘专属 FaceAnimationDef 的 targetJobs 与原包指定的 Lovin headOffset。
    Scope: FA 条件目录；21 个动作映射与位移删除范围以用户提供的原包为准。
    Mod gate: PatchOperationFindMod 只比对 mod 显示名，改名、翻译名或分支会让补丁静默失效；补丁内无法读取 packageId，也不能嵌套 IfModActive 加载目录，因此改为检查目标 mod 自带 Def 是否存在。
        RimJobWorld（rim.job.world）：存在其 JobDef RJW_Masturbate 或 GettinBred。
        旧版 Rimworld-Animations（c0ffee.rimworld.animations，1.4 及更早，显示名即旧 FindMod 所用名称）：存在其专有 Def 类型 Rimworld_Animations.AnimationDef。2.0 起改名并移除该类型，且自带 FA 兼容，不在本补丁范围内。
    Duplicate guard: 每个 targetJobs 列表逐项排除已有 Job；位移仅在原包指定节点存在时删除。
    Failure: 可选 mod、动画或目标节点缺失时条件不成立并静默跳过；不根据本机已安装 mod 改写兼容范围。
    -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/JobDef[defName="RJW_Masturbate" or defName="GettinBred"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="RJW_Masturbate")]</xpath>
                    <match Class="PatchOperationAdd">
                        <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="RJW_Masturbate")]</xpath>
                        <value>
                            <li>RJW_Masturbate</li>
                        </value>
                    </match>
                </li>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="GettinBred")]</xpath>
                    <match Class="PatchOperationAdd">
                        <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="GettinBred")]</xpath>
                        <value>
                            <li>GettinBred</li>
                        </value>
                    </match>
                </li>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="Bestiality")]</xpath>
