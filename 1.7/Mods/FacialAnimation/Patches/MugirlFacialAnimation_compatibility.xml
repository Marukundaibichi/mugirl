                <!-- 按原包仅识别旧版 Rimworld-Animations（以其专有 Def 类型判定），并只移除原包指定的帧，不扩展至其他框架版本。 -->
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/Rimworld_Animations.AnimationDef</xpath>
                    <match Class="PatchOperationSequence">
                        <operations>
                            <li Class="PatchOperationConditional">
                                <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/animationFrames/li[1]/headOffset</xpath>
