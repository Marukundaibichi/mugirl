                        </value>
                    </match>
                </li>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="BestialityForFemale")]</xpath>
                    <match Class="PatchOperationAdd">
                        <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl" or defName="Lovin2_Mugirl"]/targetJobs[not(li="BestialityForFemale")]</xpath>
