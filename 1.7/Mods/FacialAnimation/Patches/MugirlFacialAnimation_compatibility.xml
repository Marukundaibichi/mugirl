                                </match>
                            </li>
                            <li Class="PatchOperationConditional">
                                <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl"]/animationFrames/li[2]/headOffset</xpath>
                                <match Class="PatchOperationRemove">
                                    <xpath>/Defs/FacialAnimation.FaceAnimationDef[defName="LovinRepeat_Mugirl"]/animationFrames/li[2]/headOffset</xpath>
