<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <AbilityDef>
        <defName>Mugirl_Charge</defName>
        <!-- 雪牛冲锋！ -->
        <label>Mugirl Charge!</label>
        <!-- 冲冲冲！我要创死你！ -->
        <description>Charge, charge, charge! I'll ram you down!</description>
        <iconPath>UI/Mugirl_Charge</iconPath>
        <cooldownTicksRange>6000</cooldownTicksRange>
        <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
        <warmupStartSound>FireSpew_Warmup</warmupStartSound>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <!-- 冲冲冲 -->
            <label>Charge!</label>
            <warmupTime>0.5</warmupTime>
            <range>19.9</range>
            <requireLineOfSight>true</requireLineOfSight>
            <soundCast>Longjump_Jump</soundCast>
            <soundLanding>Longjump_Land</soundLanding>
            <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
            </targetParams>
        </verbProperties>
        <jobDef>Job_Charge</jobDef>
    </AbilityDef>


    <AbilityDef>
        <defName>Mugirl_Shout</defName>
        <!-- 雪牛大叫！ -->
        <label>Mugirl Shout!</label>
        <!-- RUAAAAAAAAA！（丢人的叫声） -->
        <description>RUAAAAAAAAA! (an embarrassing cry)</description>
        <iconPath>UI/Mugirl_Shout</iconPath>
        <cooldownTicksRange>6000</cooldownTicksRange>
        <targetRequired>false</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>2</warmupTime>
            <warmupEffecter>AnimalWarcall_Warmup</warmupEffecter>
            <range>6</range>
            <drawAimPie>false</drawAimPie>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Mugirl.Features.Abilities.CompProperties_AbilityEffect_ForceJobInRadius">
                <jobDef>GotoMindControlled</jobDef>
                <durationTick>240</durationTick>
                <radius>6</radius>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>Mugirl_Throw</defName>
        <aiCanUse>false</aiCanUse>
        <label>Mugirl Throw!</label>
        <description>Grab whatever's at hand and hurl it at the enemy!

This snow cow has strength to spare.</description>
        <iconPath>UI/Mugirl_Throw</iconPath>
        <!-- 5000 tick = 2 游戏小时 -->
        <cooldownTicksRange>5000</cooldownTicksRange>
        <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <label>Pick up!</label>
            <warmupTime>0.35</warmupTime>
            <range>1.5</range>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>true</canTargetBuildings>
                <canTargetItems>true</canTargetItems>
                <canTargetCorpses>true</canTargetCorpses>
                <canTargetAnimals>true</canTargetAnimals>
                <canTargetHumans>true</canTargetHumans>
                <canTargetMechs>true</canTargetMechs>
                <canTargetPlants>true</canTargetPlants>
                <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Mugirl.Features.Abilities.CompProperties_AbilityEffect_PickupThrow" />
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>Mugirl_Dunk</defName>
        <aiCanUse>false</aiCanUse>
        <label>Mugirl Meteor Slam Dunk!</label>
        <!-- 末句红色；能力 Gizmo 提示框走 Unity 富文本渲染 -->
        <description>I'll twist your head off and kick it around like a ball!

&lt;color=#ff0000&gt;You have seen what you should not have seen.&lt;/color&gt;</description>
        <iconPath>UI/Mugirl_Dunk</iconPath>
        <cooldownTicksRange>1200</cooldownTicksRange>
        <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <label>Choose a head!</label>
            <warmupTime>0</warmupTime>
            <range>30</range>
            <requireLineOfSight>false</requireLineOfSight>
            <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
                <canTargetCorpses>false</canTargetCorpses>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetHumans>true</canTargetHumans>
                <canTargetMechs>false</canTargetMechs>
                <canTargetPlants>false</canTargetPlants>
                <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
            </targetParams>
        </verbProperties>
        <jobDef>Mugirl_Dunk</jobDef>
        <comps>
            <li Class="Mugirl.Features.Abilities.CompProperties_AbilityEffect_Dunk">
                <destination>Selected</destination>
                <range>35</range>
                <requiresLineOfSight>false</requiresLineOfSight>
                <screenShakeIntensity>0.3</screenShakeIntensity>
            </li>
        </comps>
    </AbilityDef>

</Defs>
